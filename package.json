{
  "name": "algocore-fumadocs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3018",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3018",
    "typecheck": "tsc --noEmit",
    "stage8:registry": "node scripts/build-stage8-registry.mjs && node scripts/verify-stage8-registry.mjs",
    "stage8:reducer": "node scripts/verify-stage8-reducer.mjs",
    "stage8:localization": "node scripts/verify-stage8-localization.mjs",
    "verify:stage8": "npm run stage8:registry && npm run stage8:reducer && npm run stage8:localization && npm run typecheck && npm run build",
    "stage9:registry": "node scripts/build-stage9-lessons.mjs && node scripts/verify-stage9-lessons.mjs",
    "stage9:pedagogy": "node scripts/verify-stage9-pedagogy.mjs",
    "stage9:python-theory": "node scripts/audit-stage9-python-theory.mjs",
    "audit:recovery": "node scripts/audit-recovery-baseline.mjs",
    "check:paper4-v2-schema": "node scripts/check-paper4-v2-schema.mjs",
    "generate:paper4-p4r1-mappings": "node scripts/generate-paper4-p4r1-mappings.mjs",
    "check:paper4-p4r1-mappings": "node scripts/check-paper4-p4r1-mappings.mjs",
    "generate:p4r2:theory": "node scripts/build-p4r2-theory-pilot.mjs",
    "generate:p4r2:visual": "node scripts/generate-p4r2-visual-pilot.mjs",
    "generate:p4r2:assessment": "node scripts/build-p4r2-assessment-pilot.mjs",
    "generate:p4r2:registry": "node scripts/build-p4r2-pilot-registry.mjs",
    "rerun:p4r2:python": "python scripts/run-p4r2-python-pilot.py --mode author && python scripts/run-p4r2-python-pilot.py --mode independent",
    "check:p4r2:python": "python scripts/check-p4r2-python-pilot.py && node scripts/check-p4r2-python-pilot.mjs",
    "check:p4r2:theory": "node scripts/check-p4r2-theory-pilot.mjs",
    "check:p4r2:visual": "node scripts/check-p4r2-visual-pilot.mjs",
    "check:p4r2:assessment": "node scripts/check-p4r2-assessment-pilot.mjs",
    "check:p4r2:registry": "node scripts/check-p4r2-pilot-registry.mjs",
    "verify:p4r2": "npm run check:paper4-v2-schema && npm run check:p4r2:python && npm run check:p4r2:theory && npm run check:p4r2:visual && npm run check:p4r2:assessment && npm run check:p4r2:registry",
    "generate:p4r3:theory": "node scripts/build-p4r3-theory-production.mjs",
    "generate:p4r3:python": "python scripts/generate-p4r3-python-production.py",
    "rerun:p4r3:python": "python scripts/run-p4r3-python-production.py --mode author && python scripts/run-p4r3-python-production.py --mode independent",
    "generate:p4r3:assessment": "node scripts/build-p4r3-assessment-production.mjs",
    "generate:p4r4:visual": "node scripts/generate-p4r4-visual-production.mjs",
    "check:p4r3:theory": "node scripts/check-p4r3-theory-production.mjs",
    "check:p4r3:python": "python scripts/check-p4r3-python-production.py && node scripts/check-p4r3-python-production.mjs",
    "check:p4r3:assessment": "node scripts/check-p4r3-assessment-production.mjs",
    "check:p4r4:visual": "node scripts/check-p4r4-visual-production.mjs",
    "check:p4r3:a6": "node ../planning/paper4/next-phase/evidence/p4r-3/a6/check-a6-production-content.mjs",
    "verify:p4r3-p4r4": "npm run check:paper4-v2-schema && npm run check:p4r3:theory && npm run check:p4r3:python && npm run check:p4r3:assessment && npm run check:p4r4:visual && npm run check:p4r3:a6",
    "generate:paper4:full-registry": "node scripts/build-paper4-full-registry.mjs",
    "check:paper4:full-registry": "node scripts/check-paper4-full-registry.mjs",
    "verify:paper4:full-registry": "npm run check:paper4-v2-schema && npm run check:paper4:full-registry",
    "generate:paper4:v2-app-registry": "node scripts/build-paper4-v2-app-registry.mjs",
    "check:paper4:v2-app-registry": "node scripts/check-paper4-v2-app-registry.mjs",
    "check:paper4:v2-payload": "node scripts/check-paper4-v2-payload.mjs",
    "verify:paper4:v2-app-registry": "npm run check:paper4:v2-app-registry && npm run check:paper4:v2-payload",
    "check:paper4:v2-runtime": "node scripts/check-paper4-v2-runtime.mjs",
    "check:paper4:v2-routes:static": "node scripts/check-paper4-v2-routes.mjs --static-only",
    "check:paper4:v2-routes": "node scripts/check-paper4-v2-routes.mjs",
    "check:paper4:v2-axe": "node scripts/check-paper4-v2-axe.mjs",
    "check:paper4:p4r8-oop": "node scripts/check-p4r8-oop-enrichment.mjs",
    "check:paper4:p4r9-dsa": "node scripts/check-p4r9-dsa-enrichment.mjs",
    "check:paper4:p4r9-dsa:source": "node scripts/check-p4r9-dsa-enrichment.mjs --source-only",
    "verify:paper4:v2-app": "npm run verify:paper4:v2-app-registry && npm run check:paper4:v2-runtime && npm run check:paper4:v2-routes:static && npm run typecheck && npm run build",
    "verify:stage9": "npm run stage9:registry && npm run stage9:pedagogy && npm run stage9:python-theory && npm run typecheck && npm run build"
  },
  "dependencies": {
    "fumadocs-core": "16.15.11",
    "fumadocs-ui": "16.15.11",
    "lucide-react": "^0.577.0",
    "next": "16.3.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "axe-core": "^4.13.0",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
