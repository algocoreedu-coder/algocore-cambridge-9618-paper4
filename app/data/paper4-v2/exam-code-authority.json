    {
      "pattern_id": "BINARY_SEARCH",
      "lesson_slug": "binary-search",
      "teacher_gate": "REWORK_REQUIRED",
      "code": [
        "def binary_search(values, target):",
        "    low = 0",
        "    high = len(values) - 1",
        "    while low <= high:",
        "        middle = (low + high) // 2",
        "        if values[middle] == target:",
        "            return middle",
        "        if target < values[middle]:",
        "            high = middle - 1",
        "        else:",
        "            low = middle + 1",
        "    return -1"
      ]
    },
    {
      "pattern_id": "COUNT_OCCURRENCES",
      "lesson_slug": "search-collections",
      "teacher_gate": "PASS_WITH_CONTRACT",
      "code": [
        "def count_occurrences(values, target):",
        "    count = 0",
        "    for value in values:",
        "        if value == target:",
        "            count += 1",
        "    return count"
      ]
    },
    {
      "pattern_id": "FILTER_RECORDS",
      "lesson_slug": "search-collections",
      "teacher_gate": "PASS_WITH_CONTRACT",
      "code": [
        "def filter_records(records, threshold):",
        "    selected = []",
        "    for record in records:",
        "        if record[\"amount\"] >= threshold:",
        "            selected.append(record)",
        "    return selected"
      ]
    },
    {
      "pattern_id": "GROUP_AGGREGATE",
      "lesson_slug": "search-collections",
      "teacher_gate": "PASS_WITH_CONTRACT",
      "code": [
        "def group_totals(records):",
        "    totals = {}",
        "    for record in records:",
        "        key = record[\"group\"]",
        "        if key not in totals:",
        "            totals[key] = 0",
        "        totals[key] += record[\"amount\"]",
        "    return totals"
      ]
    },
    {
      "pattern_id": "HASH_SEARCH",
      "lesson_slug": "hashing",
      "teacher_gate": "REWORK_REQUIRED",
      "code": [
        "def hash_search(table, key):",
        "    start = key % len(table)",
        "    address = start",
        "    while table[address] is not None:",
        "        if table[address] == key:",
        "            return address",
        "        address = (address + 1) % len(table)",
        "        if address == start:",
        "            break",
        "    return -1"
      ]
    },
    {
      "pattern_id": "HASH_SETUP",
      "lesson_slug": "hashing",
      "teacher_gate": "REWORK_REQUIRED",
      "code": [
        "def create_hash_table(size):",
        "    return [None] * size"
      ]
    },
    {
      "pattern_id": "INSERTION_SORT",
      "lesson_slug": "sorting",
      "teacher_gate": "REWORK_REQUIRED",
      "code": [
        "def insertion_sort(values):",
        "    output = list(values)",
        "    for index in range(1, len(output)):",
        "        item = output[index]",
        "        position = index",
        "        while position > 0 and output[position - 1] > item:",
        "            output[position] = output[position - 1]",
        "            position -= 1",
        "        output[position] = item",
        "    return output"
      ]
    },
    {
      "pattern_id": "ORDERED_INSERT",
      "lesson_slug": "sorting",
      "teacher_gate": "REWORK_REQUIRED",
      "code": [
        "def ordered_insert(values, item, capacity):",
        "    if len(values) >= capacity:",
        "        return False",
        "    position = 0",
        "    while position < len(values) and values[position] <= item:",
        "        position += 1",
        "    values.append(None)",
        "    for index in range(len(values) - 1, position, -1):",
        "        values[index] = values[index - 1]",
        "    values[position] = item",
        "    return True"
      ]
    },
    {
      "pattern_id": "QUEUE_REDUCE",
      "lesson_slug": "queue",
      "teacher_gate": "REWORK_REQUIRED",
      "code": [
        "def total_queue(queue):",
        "    original_count = queue.count",
        "    total = 0",
        "    for _ in range(original_count):",
        "        item = queue.dequeue()",
        "        total += item",
        "        queue.enqueue(item)",
        "    return total"
      ]
    },
    {
      "pattern_id": "RANDOM_ARRAY",
      "lesson_slug": "data-models",
      "teacher_gate": "REWORK_REQUIRED",
      "code": [
        "from random import randint",
        "",
        "def make_random_array(size, lower, upper):",
        "    values = []",
        "    for _ in range(size):",
        "        values.append(randint(lower, upper))",
        "    return values"
      ]
    },
    {
      "pattern_id": "RUN_LENGTH_ENCODE",
      "lesson_slug": "text-processing",
      "teacher_gate": "REWORK_REQUIRED",
      "code": [
        "def run_length_encode(text):",
        "    if text == \"\":",
        "        return []",
        "    encoded = []",
        "    current = text[0]",
        "    count = 1",
        "    for character in text[1:]:",
        "        if character == current:",
        "            count += 1",
        "        else:",
        "            encoded.append([current, count])",
        "            current = character",
        "            count = 1",
        "    encoded.append([current, count])",
        "    return encoded"
      ]
    },
    {
      "pattern_id": "STACK_PAIR",
      "lesson_slug": "stack",
      "teacher_gate": "PASS_WITH_CONTRACT",
      "code": [
        "def pop_pair(left_stack, right_stack):",
        "    if left_stack.top == -1 or right_stack.top == -1:",
        "        return None",
        "    left_item = left_stack.pop()",
        "    right_item = right_stack.pop()",
        "    return [left_item, right_item]"
      ]
    },
    {
      "pattern_id": "STACK_REDUCE",
      "lesson_slug": "stack",
      "teacher_gate": "PASS_WITH_CONTRACT",
      "code": [
        "def subtract_top_two(stack):",
        "    if stack.top < 1:",
        "        return None",
        "    right = stack.pop()",
        "    left = stack.pop()",
        "    return left - right"
      ]
    },
    {
      "pattern_id": "STRING_COMPARE",
      "lesson_slug": "text-processing",
      "teacher_gate": "REWORK_REQUIRED",
      "code": [
        "def compare_text(left, right):",
        "    limit = min(len(left), len(right))",
        "    for index in range(limit):",
        "        if left[index] < right[index]:",
        "            return -1",
        "        if left[index] > right[index]:",
        "            return 1",
        "    if len(left) == len(right):",
        "        return 0",
        "    return -1 if len(left) < len(right) else 1"
      ]
    },
    {
      "pattern_id": "TREE_INSERT",
      "lesson_slug": "binary-tree",
      "teacher_gate": "REWORK_REQUIRED",
      "code": [
        "def insert(root, value):",
        "    if root is None:",
        "        return Node(value)",
        "    if value < root.value:",
        "        root.left = insert(root.left, value)",
        "    elif value > root.value:",
        "        root.right = insert(root.right, value)",
        "    return root"
      ]
    },
    {
      "pattern_id": "TREE_SETUP",
      "lesson_slug": "binary-tree",
      "teacher_gate": "REWORK_REQUIRED",
      "code": [
        "class Node:",
        "    def __init__(self, value):",
        "        self.value = value",
        "        self.left = None",
        "        self.right = None",
        "",
        "root = None"
      ]
    },
    {
      "pattern_id": "TREE_TRAVERSE",
      "lesson_slug": "binary-tree",
      "teacher_gate": "REWORK_REQUIRED",
      "code": [
        "def inorder(node, output):",
        "    if node is not None:",
        "        inorder(node.left, output)",
        "        output.append(node.value)",
        "        inorder(node.right, output)"
      ]
    }
  ]
