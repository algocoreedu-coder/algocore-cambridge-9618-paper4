        "text": ""
      },
      {
        "line_id": "oop-inheritance.production-v1.L003",
        "order": 3,
        "text": "class Shape:"
      },
      {
        "line_id": "oop-inheritance.production-v1.L004",
        "order": 4,
        "text": "    def __init__(self, name):"
      },
      {
        "line_id": "oop-inheritance.production-v1.L005",
        "order": 5,
        "text": "        self.name = name"
      },
      {
        "line_id": "oop-inheritance.production-v1.L006",
        "order": 6,
        "text": ""
      },
      {
        "line_id": "oop-inheritance.production-v1.L007",
        "order": 7,
        "text": "    def area(self):"
      },
      {
        "line_id": "oop-inheritance.production-v1.L008",
        "order": 8,
        "text": "        raise NotImplementedError(\"subclass must implement area\")"
      },
      {
        "line_id": "oop-inheritance.production-v1.L009",
        "order": 9,
        "text": ""
      },
      {
        "line_id": "oop-inheritance.production-v1.L010",
        "order": 10,
        "text": "class Rectangle(Shape):"
      },
      {
        "line_id": "oop-inheritance.production-v1.L011",
        "order": 11,
        "text": "    def __init__(self, width, height):"
      },
      {
        "line_id": "oop-inheritance.production-v1.L012",
        "order": 12,
        "text": "        if width < 0 or height < 0:"
      },
      {
        "line_id": "oop-inheritance.production-v1.L013",
        "order": 13,
        "text": "            raise ValueError(\"negative size\")"
      },
      {
        "line_id": "oop-inheritance.production-v1.L014",
        "order": 14,
        "text": "        super().__init__(\"rectangle\")"
      },
      {
        "line_id": "oop-inheritance.production-v1.L015",
        "order": 15,
        "text": "        self.width = width"
      },
      {
        "line_id": "oop-inheritance.production-v1.L016",
        "order": 16,
        "text": "        self.height = height"
      },
      {
        "line_id": "oop-inheritance.production-v1.L017",
        "order": 17,
        "text": ""
      },
      {
        "line_id": "oop-inheritance.production-v1.L018",
        "order": 18,
        "text": "    def area(self):"
      },
      {
        "line_id": "oop-inheritance.production-v1.L019",
        "order": 19,
        "text": "        return self.width * self.height"
      },
      {
        "line_id": "oop-inheritance.production-v1.L020",
        "order": 20,
        "text": ""
      },
      {
        "line_id": "oop-inheritance.production-v1.L021",
        "order": 21,
        "text": "class Circle(Shape):"
      },
      {
        "line_id": "oop-inheritance.production-v1.L022",
        "order": 22,
        "text": "    def __init__(self, radius):"
      },
      {
        "line_id": "oop-inheritance.production-v1.L023",
        "order": 23,
        "text": "        if radius < 0:"
      },
      {
        "line_id": "oop-inheritance.production-v1.L024",
        "order": 24,
        "text": "            raise ValueError(\"negative size\")"
      },
      {
        "line_id": "oop-inheritance.production-v1.L025",
        "order": 25,
        "text": "        super().__init__(\"circle\")"
      },
      {
        "line_id": "oop-inheritance.production-v1.L026",
        "order": 26,
        "text": "        self.radius = radius"
      },
      {
        "line_id": "oop-inheritance.production-v1.L027",
        "order": 27,
        "text": ""
      },
      {
        "line_id": "oop-inheritance.production-v1.L028",
        "order": 28,
        "text": "    def area(self):"
      },
      {
        "line_id": "oop-inheritance.production-v1.L029",
        "order": 29,
        "text": "        return round(3.14 * self.radius * self.radius, 2)"
      },
      {
        "line_id": "oop-inheritance.production-v1.L030",
        "order": 30,
        "text": ""
      },
      {
        "line_id": "oop-inheritance.production-v1.L031",
        "order": 31,
        "text": "def run(fixture):"
      },
      {
        "line_id": "oop-inheritance.production-v1.L032",
        "order": 32,
        "text": "    shapes = []"
      },
      {
        "line_id": "oop-inheritance.production-v1.L033",
        "order": 33,
        "text": "    rejected = 0"
      },
      {
        "line_id": "oop-inheritance.production-v1.L034",
        "order": 34,
        "text": "    trace = []"
      },
      {
        "line_id": "oop-inheritance.production-v1.L035",
        "order": 35,
        "text": "    for record in fixture.get(\"shapes\", []):"
      },
      {
        "line_id": "oop-inheritance.production-v1.L036",
        "order": 36,
        "text": "        try:"
      },
      {
        "line_id": "oop-inheritance.production-v1.L037",
        "order": 37,
        "text": "            if record[\"type\"] == \"rectangle\":"
      },
      {
        "line_id": "oop-inheritance.production-v1.L038",
        "order": 38,
        "text": "                shape = Rectangle(record[\"width\"], record[\"height\"])"
      },
      {
        "line_id": "oop-inheritance.production-v1.L039",
        "order": 39,
        "text": "            elif record[\"type\"] == \"circle\":"
      },
      {
        "line_id": "oop-inheritance.production-v1.L040",
        "order": 40,
        "text": "                shape = Circle(record[\"radius\"])"
      },
      {
        "line_id": "oop-inheritance.production-v1.L041",
        "order": 41,
        "text": "            else:"
      },
      {
        "line_id": "oop-inheritance.production-v1.L042",
        "order": 42,
        "text": "                raise ValueError(\"unknown shape\")"
      },
      {
        "line_id": "oop-inheritance.production-v1.L043",
        "order": 43,
        "text": "            shapes.append(shape)"
      },
      {
        "line_id": "oop-inheritance.production-v1.L044",
        "order": 44,
        "text": "            trace.append({\"event\": \"constructor_chain\", \"runtime_type\": type(shape).__name__})"
      },
      {
        "line_id": "oop-inheritance.production-v1.L045",
        "order": 45,
        "text": "        except (KeyError, ValueError):"
      },
      {
        "line_id": "oop-inheritance.production-v1.L046",
        "order": 46,
        "text": "            rejected += 1"
      },
      {
        "line_id": "oop-inheritance.production-v1.L047",
        "order": 47,
        "text": "            trace.append({\"event\": \"reject_subclass\"})"
      },
      {
        "line_id": "oop-inheritance.production-v1.L048",
        "order": 48,
        "text": "    outputs = []"
      },
      {
        "line_id": "oop-inheritance.production-v1.L049",
        "order": 49,
        "text": "    for shape in shapes:"
      },
      {
        "line_id": "oop-inheritance.production-v1.L050",
        "order": 50,
        "text": "        area = shape.area()"
      },
      {
        "line_id": "oop-inheritance.production-v1.L051",
        "order": 51,
        "text": "        outputs.append({\"name\": shape.name, \"area\": area})"
      },
      {
        "line_id": "oop-inheritance.production-v1.L052",
        "order": 52,
        "text": "        trace.append({\"event\": \"dynamic_dispatch\", \"runtime_type\": type(shape).__name__, \"method\": \"area\", \"result\": area})"
      },
      {
        "line_id": "oop-inheritance.production-v1.L053",
        "order": 53,
        "text": "    return {"
      },
      {
        "line_id": "oop-inheritance.production-v1.L054",
        "order": 54,
        "text": "        \"status\": \"OK\" if rejected == 0 else \"REJECTED_INVALID_SUBCLASS\","
      },
      {
        "line_id": "oop-inheritance.production-v1.L055",
        "order": 55,
        "text": "        \"outputs\": outputs,"
      },
      {
        "line_id": "oop-inheritance.production-v1.L056",
        "order": 56,
        "text": "        \"rejected\": rejected,"
      },
      {
        "line_id": "oop-inheritance.production-v1.L057",
        "order": 57,
        "text": "        \"trace\": trace,"
      },
      {
        "line_id": "oop-inheritance.production-v1.L058",
        "order": 58,
        "text": "    }"
      },
      {
        "line_id": "oop-inheritance.production-v1.L059",
        "order": 59,
        "text": ""
      },
      {
        "line_id": "oop-inheritance.production-v1.L060",
        "order": 60,
        "text": "if __name__ == \"__main__\":"
      },
      {
        "line_id": "oop-inheritance.production-v1.L061",
        "order": 61,
        "text": "    import json"
      },
      {
        "line_id": "oop-inheritance.production-v1.L062",
        "order": 62,
        "text": "    import sys"
      },
      {
        "line_id": "oop-inheritance.production-v1.L063",
        "order": 63,
        "text": "    fixture = json.loads(Path(sys.argv[1]).read_text(encoding=\"utf-8\"))"
      },
      {
        "line_id": "oop-inheritance.production-v1.L064",
        "order": 64,
        "text": "    result = run(fixture)"
