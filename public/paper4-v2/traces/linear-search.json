    "lines": [
      {
        "line_id": "search-collections.production-v1.L001",
        "order": 1,
        "text": "from pathlib import Path"
      },
      {
        "line_id": "search-collections.production-v1.L002",
        "order": 2,
        "text": ""
      },
      {
        "line_id": "search-collections.production-v1.L003",
        "order": 3,
        "text": "def run(fixture):"
      },
      {
        "line_id": "search-collections.production-v1.L004",
        "order": 4,
        "text": "    trace, found = [], -1"
      },
      {
        "line_id": "search-collections.production-v1.L005",
        "order": 5,
        "text": "    values = fixture.get(\"values\", [])"
      },
      {
        "line_id": "search-collections.production-v1.L006",
        "order": 6,
        "text": "    for index, value in enumerate(values):"
      },
      {
        "line_id": "search-collections.production-v1.L007",
        "order": 7,
        "text": "        trace.append({\"event\": \"inspect\", \"index\": index, \"match\": value == fixture[\"target\"]})"
      },
      {
        "line_id": "search-collections.production-v1.L008",
        "order": 8,
        "text": "        if found == -1 and value == fixture[\"target\"]:"
      },
      {
        "line_id": "search-collections.production-v1.L009",
        "order": 9,
        "text": "            found = index"
      },
      {
        "line_id": "search-collections.production-v1.L010",
        "order": 10,
        "text": "    records = fixture.get(\"records\", [])"
      },
      {
        "line_id": "search-collections.production-v1.L011",
        "order": 11,
        "text": "    if any(\"group\" not in record or \"amount\" not in record for record in records):"
      },
      {
        "line_id": "search-collections.production-v1.L012",
        "order": 12,
        "text": "        return {\"status\": \"MALFORMED_RECORD\", \"found\": found, \"groups\": {}, \"trace\": trace + [{\"event\": \"reject_record\"}]}"
      },
      {
        "line_id": "search-collections.production-v1.L013",
        "order": 13,
        "text": "    groups, filtered = {}, []"
      },
      {
        "line_id": "search-collections.production-v1.L014",
        "order": 14,
        "text": "    for record in records:"
      },
      {
        "line_id": "search-collections.production-v1.L015",
        "order": 15,
        "text": "        groups[record[\"group\"]] = groups.get(record[\"group\"], 0) + record[\"amount\"]"
      },
      {
        "line_id": "search-collections.production-v1.L016",
        "order": 16,
        "text": "        if record[\"amount\"] >= fixture[\"threshold\"]:"
      },
      {
        "line_id": "search-collections.production-v1.L017",
        "order": 17,
        "text": "            filtered.append(record)"
      },
      {
        "line_id": "search-collections.production-v1.L018",
        "order": 18,
        "text": "    return {\"status\": \"OK\", \"found\": found, \"count\": sum(value == fixture[\"target\"] for value in values), \"filtered\": filtered, \"groups\": groups, \"trace\": trace + [{\"event\": \"aggregate\", \"groups\": len(groups)}]}"
      },
      {
        "line_id": "search-collections.production-v1.L019",
        "order": 19,
        "text": ""
      },
      {
        "line_id": "search-collections.production-v1.L020",
        "order": 20,
        "text": "if __name__ == \"__main__\":"
      },
      {
        "line_id": "search-collections.production-v1.L021",
        "order": 21,
        "text": "    import json"
      },
      {
        "line_id": "search-collections.production-v1.L022",
        "order": 22,
        "text": "    import sys"
      },
      {
        "line_id": "search-collections.production-v1.L023",
        "order": 23,
        "text": "    fixture = json.loads(Path(sys.argv[1]).read_text(encoding=\"utf-8\"))"
      },
      {
        "line_id": "search-collections.production-v1.L024",
        "order": 24,
        "text": "    result = run(fixture)"
      },
      {
        "line_id": "search-collections.production-v1.L025",
        "order": 25,
        "text": "    if not result[\"trace\"]:"
      },
      {
        "line_id": "search-collections.production-v1.L026",
        "order": 26,
        "text": "        result[\"trace\"].append({\"event\": \"complete_no_steps\"})"
      },
      {
        "line_id": "search-collections.production-v1.L027",
        "order": 27,
        "text": "    print(json.dumps(result, ensure_ascii=False, sort_keys=True, separators=(\",\", \":\")))"
      },
      {
        "line_id": "search-collections.production-v1.L028",
        "order": 28,
        "text": ""
      }
    ],
