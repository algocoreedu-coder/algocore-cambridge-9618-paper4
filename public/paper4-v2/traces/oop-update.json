    "lines": [
      {
        "line_id": "oop-state.production-v1.L001",
        "order": 1,
        "text": "from pathlib import Path"
      },
      {
        "line_id": "oop-state.production-v1.L002",
        "order": 2,
        "text": ""
      },
      {
        "line_id": "oop-state.production-v1.L003",
        "order": 3,
        "text": "class Account:"
      },
      {
        "line_id": "oop-state.production-v1.L004",
        "order": 4,
        "text": "    def __init__(self, balance, limit):"
      },
      {
        "line_id": "oop-state.production-v1.L005",
        "order": 5,
        "text": "        self.__balance = balance"
      },
      {
        "line_id": "oop-state.production-v1.L006",
        "order": 6,
        "text": "        self.__limit = limit"
      },
      {
        "line_id": "oop-state.production-v1.L007",
        "order": 7,
        "text": ""
      },
      {
        "line_id": "oop-state.production-v1.L008",
        "order": 8,
        "text": "    def get_balance(self):"
      },
      {
        "line_id": "oop-state.production-v1.L009",
        "order": 9,
        "text": "        return self.__balance"
      },
      {
        "line_id": "oop-state.production-v1.L010",
        "order": 10,
        "text": ""
      },
      {
        "line_id": "oop-state.production-v1.L011",
        "order": 11,
        "text": "    def set_balance(self, value):"
      },
      {
        "line_id": "oop-state.production-v1.L012",
        "order": 12,
        "text": "        if not 0 <= value <= self.__limit:"
      },
      {
        "line_id": "oop-state.production-v1.L013",
        "order": 13,
        "text": "            return False"
      },
      {
        "line_id": "oop-state.production-v1.L014",
        "order": 14,
        "text": "        self.__balance = value"
      },
      {
        "line_id": "oop-state.production-v1.L015",
        "order": 15,
        "text": "        return True"
      },
      {
        "line_id": "oop-state.production-v1.L016",
        "order": 16,
        "text": ""
      },
      {
        "line_id": "oop-state.production-v1.L017",
        "order": 17,
        "text": "    def apply_change(self, delta):"
      },
      {
        "line_id": "oop-state.production-v1.L018",
        "order": 18,
        "text": "        candidate = self.__balance + delta"
      },
      {
        "line_id": "oop-state.production-v1.L019",
        "order": 19,
        "text": "        return self.set_balance(candidate)"
      },
      {
        "line_id": "oop-state.production-v1.L020",
        "order": 20,
        "text": ""
      },
      {
        "line_id": "oop-state.production-v1.L021",
        "order": 21,
        "text": "def run(fixture):"
      },
      {
        "line_id": "oop-state.production-v1.L022",
        "order": 22,
        "text": "    account = Account(fixture[\"start\"], fixture[\"limit\"])"
      },
      {
        "line_id": "oop-state.production-v1.L023",
        "order": 23,
        "text": "    trace = []"
      },
      {
        "line_id": "oop-state.production-v1.L024",
        "order": 24,
        "text": "    old = account.get_balance()"
      },
      {
        "line_id": "oop-state.production-v1.L025",
        "order": 25,
        "text": "    setter_ok = account.set_balance(fixture[\"replacement\"])"
      },
      {
        "line_id": "oop-state.production-v1.L026",
        "order": 26,
        "text": "    trace.append({\"event\": \"setter\", \"success\": setter_ok, \"balance\": account.get_balance()})"
      },
      {
        "line_id": "oop-state.production-v1.L027",
        "order": 27,
        "text": "    before_update = account.get_balance()"
      },
      {
        "line_id": "oop-state.production-v1.L028",
        "order": 28,
        "text": "    update_ok = account.apply_change(fixture[\"delta\"])"
      },
      {
        "line_id": "oop-state.production-v1.L029",
        "order": 29,
        "text": "    trace.append({\"event\": \"rule_update\", \"success\": update_ok, \"balance\": account.get_balance()})"
      },
      {
        "line_id": "oop-state.production-v1.L030",
        "order": 30,
        "text": "    preserved = update_ok or account.get_balance() == before_update"
      },
      {
        "line_id": "oop-state.production-v1.L031",
        "order": 31,
        "text": "    return {"
      },
      {
        "line_id": "oop-state.production-v1.L032",
        "order": 32,
        "text": "        \"status\": \"OK\","
      },
      {
        "line_id": "oop-state.production-v1.L033",
        "order": 33,
        "text": "        \"old\": old,"
      },
      {
        "line_id": "oop-state.production-v1.L034",
        "order": 34,
        "text": "        \"balance\": account.get_balance(),"
      },
      {
        "line_id": "oop-state.production-v1.L035",
        "order": 35,
        "text": "        \"setter_ok\": setter_ok,"
      },
      {
        "line_id": "oop-state.production-v1.L036",
        "order": 36,
        "text": "        \"update_ok\": update_ok,"
      },
      {
        "line_id": "oop-state.production-v1.L037",
        "order": 37,
        "text": "        \"preserved_after_failed_update\": preserved,"
      },
      {
        "line_id": "oop-state.production-v1.L038",
        "order": 38,
        "text": "        \"trace\": trace,"
      },
      {
        "line_id": "oop-state.production-v1.L039",
        "order": 39,
        "text": "    }"
      },
      {
        "line_id": "oop-state.production-v1.L040",
        "order": 40,
        "text": ""
      },
      {
        "line_id": "oop-state.production-v1.L041",
        "order": 41,
        "text": "if __name__ == \"__main__\":"
      },
      {
        "line_id": "oop-state.production-v1.L042",
        "order": 42,
        "text": "    import json"
      },
      {
        "line_id": "oop-state.production-v1.L043",
        "order": 43,
        "text": "    import sys"
      },
      {
        "line_id": "oop-state.production-v1.L044",
        "order": 44,
        "text": "    fixture = json.loads(Path(sys.argv[1]).read_text(encoding=\"utf-8\"))"
      },
      {
        "line_id": "oop-state.production-v1.L045",
        "order": 45,
        "text": "    result = run(fixture)"
