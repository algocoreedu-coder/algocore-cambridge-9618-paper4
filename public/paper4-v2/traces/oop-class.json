    "language": "python",
    "lines": [
      {
        "line_id": "oop-model.production-v1.L001",
        "order": 1,
        "text": "from pathlib import Path"
      },
      {
        "line_id": "oop-model.production-v1.L002",
        "order": 2,
        "text": ""
      },
      {
        "line_id": "oop-model.production-v1.L003",
        "order": 3,
        "text": "class Student:"
      },
      {
        "line_id": "oop-model.production-v1.L004",
        "order": 4,
        "text": "    def __init__(self, student_id, name, score=0):"
      },
      {
        "line_id": "oop-model.production-v1.L005",
        "order": 5,
        "text": "        if not isinstance(student_id, int) or student_id < 1 or not isinstance(score, int) or not 0 <= score <= 100:"
      },
      {
        "line_id": "oop-model.production-v1.L006",
        "order": 6,
        "text": "            raise ValueError(\"invalid student\")"
      },
      {
        "line_id": "oop-model.production-v1.L007",
        "order": 7,
        "text": "        self.student_id, self.name, self.score = student_id, name, score"
      },
      {
        "line_id": "oop-model.production-v1.L008",
        "order": 8,
        "text": "    def state(self): return {\"student_id\": self.student_id, \"name\": self.name, \"score\": self.score}"
      },
      {
        "line_id": "oop-model.production-v1.L009",
        "order": 9,
        "text": ""
      },
      {
        "line_id": "oop-model.production-v1.L010",
        "order": 10,
        "text": "def run(fixture):"
      },
      {
        "line_id": "oop-model.production-v1.L011",
        "order": 11,
        "text": "    objects, rejected, trace = [], 0, []"
      },
      {
        "line_id": "oop-model.production-v1.L012",
        "order": 12,
        "text": "    for record in fixture.get(\"records\", []):"
      },
      {
        "line_id": "oop-model.production-v1.L013",
        "order": 13,
        "text": "        try:"
      },
      {
        "line_id": "oop-model.production-v1.L014",
        "order": 14,
        "text": "            student = Student(record.get(\"student_id\"), record.get(\"name\", \"\"), record.get(\"score\", 0))"
      },
      {
        "line_id": "oop-model.production-v1.L015",
        "order": 15,
        "text": "            objects.append(student); trace.append({\"event\": \"instantiate\", \"student_id\": student.student_id})"
      },
      {
        "line_id": "oop-model.production-v1.L016",
        "order": 16,
        "text": "        except (TypeError, ValueError):"
      },
      {
        "line_id": "oop-model.production-v1.L017",
        "order": 17,
        "text": "            rejected += 1; trace.append({\"event\": \"reject_constructor\"})"
      },
      {
        "line_id": "oop-model.production-v1.L018",
        "order": 18,
        "text": "    states = [student.state() for student in objects]"
      },
      {
        "line_id": "oop-model.production-v1.L019",
        "order": 19,
        "text": "    return {\"status\": \"OK\" if rejected == 0 else \"PARTIAL_REJECT\", \"objects\": states, \"rejected\": rejected, \"independent_instances\": len({id(student) for student in objects}) == len(objects), \"trace\": trace}"
      },
      {
        "line_id": "oop-model.production-v1.L020",
        "order": 20,
        "text": ""
      },
      {
        "line_id": "oop-model.production-v1.L021",
        "order": 21,
        "text": "if __name__ == \"__main__\":"
      },
      {
        "line_id": "oop-model.production-v1.L022",
        "order": 22,
        "text": "    import json"
      },
      {
        "line_id": "oop-model.production-v1.L023",
        "order": 23,
        "text": "    import sys"
      },
      {
        "line_id": "oop-model.production-v1.L024",
        "order": 24,
        "text": "    fixture = json.loads(Path(sys.argv[1]).read_text(encoding=\"utf-8\"))"
      },
      {
        "line_id": "oop-model.production-v1.L025",
        "order": 25,
        "text": "    result = run(fixture)"
      },
      {
        "line_id": "oop-model.production-v1.L026",
        "order": 26,
        "text": "    if not result[\"trace\"]:"
      },
      {
        "line_id": "oop-model.production-v1.L027",
        "order": 27,
        "text": "        result[\"trace\"].append({\"event\": \"complete_no_steps\"})"
      },
      {
        "line_id": "oop-model.production-v1.L028",
        "order": 28,
        "text": "    print(json.dumps(result, ensure_ascii=False, sort_keys=True, separators=(\",\", \":\")))"
      },
      {
        "line_id": "oop-model.production-v1.L029",
        "order": 29,
        "text": ""
      }
    ],
    "entry_point": "run(fixture)",
