  "lines": [
    {
      "line_id": "stack.production-v1.L001",
      "order": 1,
      "text": "from pathlib import Path"
    },
    {
      "line_id": "stack.production-v1.L002",
      "order": 2,
      "text": ""
    },
    {
      "line_id": "stack.production-v1.L003",
      "order": 3,
      "text": "class Stack:"
    },
    {
      "line_id": "stack.production-v1.L004",
      "order": 4,
      "text": "    def __init__(self, capacity):"
    },
    {
      "line_id": "stack.production-v1.L005",
      "order": 5,
      "text": "        self.items = [None] * capacity"
    },
    {
      "line_id": "stack.production-v1.L006",
      "order": 6,
      "text": "        self.top = -1"
    },
    {
      "line_id": "stack.production-v1.L007",
      "order": 7,
      "text": "    def push(self, value):"
    },
    {
      "line_id": "stack.production-v1.L008",
      "order": 8,
      "text": "        if self.top + 1 == len(self.items):"
    },
    {
      "line_id": "stack.production-v1.L009",
      "order": 9,
      "text": "            return False"
    },
    {
      "line_id": "stack.production-v1.L010",
      "order": 10,
      "text": "        self.top += 1"
    },
    {
      "line_id": "stack.production-v1.L011",
      "order": 11,
      "text": "        self.items[self.top] = value"
    },
    {
      "line_id": "stack.production-v1.L012",
      "order": 12,
      "text": "        return True"
    },
    {
      "line_id": "stack.production-v1.L013",
      "order": 13,
      "text": "    def pop(self):"
    },
    {
      "line_id": "stack.production-v1.L014",
      "order": 14,
      "text": "        if self.top == -1:"
    },
    {
      "line_id": "stack.production-v1.L015",
      "order": 15,
      "text": "            return None"
    },
    {
      "line_id": "stack.production-v1.L016",
      "order": 16,
      "text": "        value = self.items[self.top]"
    },
    {
      "line_id": "stack.production-v1.L017",
      "order": 17,
      "text": "        self.items[self.top] = None"
    },
    {
      "line_id": "stack.production-v1.L018",
      "order": 18,
      "text": "        self.top -= 1"
    },
    {
      "line_id": "stack.production-v1.L019",
      "order": 19,
      "text": "        return value"
    },
    {
      "line_id": "stack.production-v1.L020",
      "order": 20,
      "text": "    def live(self):"
    },
    {
      "line_id": "stack.production-v1.L021",
      "order": 21,
      "text": "        return self.items[:self.top + 1]"
    },
    {
      "line_id": "stack.production-v1.L022",
      "order": 22,
      "text": ""
    },
    {
      "line_id": "stack.production-v1.L023",
      "order": 23,
      "text": "def stack_from(values):"
    },
    {
      "line_id": "stack.production-v1.L024",
      "order": 24,
      "text": "    stack = Stack(len(values))"
    },
    {
      "line_id": "stack.production-v1.L025",
      "order": 25,
      "text": "    for value in values:"
    },
    {
      "line_id": "stack.production-v1.L026",
      "order": 26,
      "text": "        stack.push(value)"
    },
    {
      "line_id": "stack.production-v1.L027",
      "order": 27,
      "text": "    return stack"
    },
    {
      "line_id": "stack.production-v1.L028",
      "order": 28,
      "text": ""
    },
    {
      "line_id": "stack.production-v1.L029",
      "order": 29,
      "text": "def pair_stacks(left_stack, right_stack, trace):"
    },
    {
      "line_id": "stack.production-v1.L030",
      "order": 30,
      "text": "    before = {\"left\": left_stack.live(), \"right\": right_stack.live()}"
    },
    {
      "line_id": "stack.production-v1.L031",
      "order": 31,
      "text": "    left_item = left_stack.pop()"
    },
    {
      "line_id": "stack.production-v1.L032",
      "order": 32,
      "text": "    right_item = right_stack.pop()"
    },
    {
      "line_id": "stack.production-v1.L033",
      "order": 33,
      "text": "    if left_item is None or right_item is None:"
    },
    {
      "line_id": "stack.production-v1.L034",
      "order": 34,
      "text": "        if left_item is not None:"
    },
    {
      "line_id": "stack.production-v1.L035",
      "order": 35,
      "text": "            left_stack.push(left_item)"
    },
    {
      "line_id": "stack.production-v1.L036",
      "order": 36,
      "text": "        if right_item is not None:"
    },
    {
      "line_id": "stack.production-v1.L037",
      "order": 37,
      "text": "            right_stack.push(right_item)"
    },
    {
      "line_id": "stack.production-v1.L038",
      "order": 38,
      "text": "        trace.append({\"event\": \"pair_rollback\", \"before\": before, \"after\": {\"left\": left_stack.live(), \"right\": right_stack.live()}})"
    },
    {
      "line_id": "stack.production-v1.L039",
      "order": 39,
      "text": "        return None"
    },
    {
      "line_id": "stack.production-v1.L040",
      "order": 40,
      "text": "    pair = [left_item, right_item]"
    },
    {
      "line_id": "stack.production-v1.L041",
      "order": 41,
      "text": "    trace.append({\"event\": \"pair_commit\", \"pair\": pair, \"before\": before, \"after\": {\"left\": left_stack.live(), \"right\": right_stack.live()}})"
    },
    {
      "line_id": "stack.production-v1.L042",
      "order": 42,
      "text": "    return pair"
    },
    {
      "line_id": "stack.production-v1.L043",
      "order": 43,
      "text": ""
    },
    {
      "line_id": "stack.production-v1.L044",
      "order": 44,
      "text": "def reduce_operands(values):"
    },
    {
      "line_id": "stack.production-v1.L045",
      "order": 45,
      "text": "    stack = stack_from(values)"
    },
    {
      "line_id": "stack.production-v1.L046",
      "order": 46,
      "text": "    right, left = stack.pop(), stack.pop()"
    },
    {
      "line_id": "stack.production-v1.L047",
      "order": 47,
      "text": "    return None if left is None or right is None else left - right"
    },
    {
      "line_id": "stack.production-v1.L048",
      "order": 48,
      "text": ""
    },
    {
      "line_id": "stack.production-v1.L049",
      "order": 49,
      "text": "def run(fixture):"
    },
    {
      "line_id": "stack.production-v1.L050",
      "order": 50,
      "text": "    stack, trace, results = Stack(fixture[\"capacity\"]), [], []"
    },
    {
      "line_id": "stack.production-v1.L051",
      "order": 51,
      "text": "    for operation in fixture[\"operations\"]:"
    },
    {
      "line_id": "stack.production-v1.L052",
      "order": 52,
      "text": "        before = {\"top\": stack.top, \"live\": stack.live()}"
    },
    {
      "line_id": "stack.production-v1.L053",
      "order": 53,
      "text": "        if operation[0] == \"push\":"
    },
    {
      "line_id": "stack.production-v1.L054",
      "order": 54,
      "text": "            outcome = stack.push(operation[1])"
    },
    {
      "line_id": "stack.production-v1.L055",
      "order": 55,
      "text": "        else:"
    },
    {
      "line_id": "stack.production-v1.L056",
      "order": 56,
      "text": "            outcome = stack.pop()"
    },
    {
      "line_id": "stack.production-v1.L057",
      "order": 57,
      "text": "        results.append(outcome)"
    },
    {
      "line_id": "stack.production-v1.L058",
      "order": 58,
      "text": "        trace.append({\"event\": operation[0], \"before\": before, \"after\": {\"top\": stack.top, \"live\": stack.live()}, \"outcome\": outcome})"
    },
    {
      "line_id": "stack.production-v1.L059",
      "order": 59,
      "text": "    left_stack = stack_from(fixture.get(\"pair_left\", []))"
    },
    {
      "line_id": "stack.production-v1.L060",
      "order": 60,
      "text": "    right_stack = stack_from(fixture.get(\"pair_right\", []))"
    },
    {
      "line_id": "stack.production-v1.L061",
      "order": 61,
      "text": "    pair = pair_stacks(left_stack, right_stack, trace)"
    },
    {
      "line_id": "stack.production-v1.L062",
      "order": 62,
      "text": "    reduced = reduce_operands(fixture.get(\"operands\", []))"
    },
    {
      "line_id": "stack.production-v1.L063",
      "order": 63,
      "text": "    return {\"status\": \"OK\", \"results\": results, \"live\": stack.live(), \"top\": stack.top, \"pair\": pair, \"pair_left\": left_stack.live(), \"pair_right\": right_stack.live(), \"reduced\": reduced, \"trace\": trace}"
    },
    {
