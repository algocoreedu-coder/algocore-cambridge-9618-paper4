  "lines": [
    {
      "line_id": "text-files.production-v1.L001",
      "order": 1,
      "text": "from pathlib import Path"
    },
    {
      "line_id": "text-files.production-v1.L002",
      "order": 2,
      "text": "from tempfile import TemporaryDirectory"
    },
    {
      "line_id": "text-files.production-v1.L003",
      "order": 3,
      "text": ""
    },
    {
      "line_id": "text-files.production-v1.L004",
      "order": 4,
      "text": "def parse_records(text):"
    },
    {
      "line_id": "text-files.production-v1.L005",
      "order": 5,
      "text": "    records = []"
    },
    {
      "line_id": "text-files.production-v1.L006",
      "order": 6,
      "text": "    for raw in text.splitlines():"
    },
    {
      "line_id": "text-files.production-v1.L007",
      "order": 7,
      "text": "        if raw == \"\": continue"
    },
    {
      "line_id": "text-files.production-v1.L008",
      "order": 8,
      "text": "        fields = raw.split(\",\")"
    },
    {
      "line_id": "text-files.production-v1.L009",
      "order": 9,
      "text": "        if len(fields) != 2: raise ValueError(\"malformed record\")"
    },
    {
      "line_id": "text-files.production-v1.L010",
      "order": 10,
      "text": "        records.append({\"name\": fields[0], \"score\": int(fields[1])})"
    },
    {
      "line_id": "text-files.production-v1.L011",
      "order": 11,
      "text": "    return records"
    },
    {
      "line_id": "text-files.production-v1.L012",
      "order": 12,
      "text": ""
    },
    {
      "line_id": "text-files.production-v1.L013",
      "order": 13,
      "text": "def run(fixture):"
    },
    {
      "line_id": "text-files.production-v1.L014",
      "order": 14,
      "text": "    trace = []"
    },
    {
      "line_id": "text-files.production-v1.L015",
      "order": 15,
      "text": "    with TemporaryDirectory() as directory:"
    },
    {
      "line_id": "text-files.production-v1.L016",
      "order": 16,
      "text": "        source, output = Path(directory) / \"input.txt\", Path(directory) / \"output.txt\""
    },
    {
      "line_id": "text-files.production-v1.L017",
      "order": 17,
      "text": "        source.write_text(fixture[\"content\"], encoding=\"utf-8\", newline=\"\\n\")"
    },
    {
      "line_id": "text-files.production-v1.L018",
      "order": 18,
      "text": "        committed = fixture.get(\"committed\", \"SAFE\\n\")"
    },
    {
      "line_id": "text-files.production-v1.L019",
      "order": 19,
      "text": "        output.write_text(committed, encoding=\"utf-8\", newline=\"\\n\")"
    },
    {
      "line_id": "text-files.production-v1.L020",
      "order": 20,
      "text": "        try:"
    },
    {
      "line_id": "text-files.production-v1.L021",
      "order": 21,
      "text": "            records = parse_records(source.read_text(encoding=\"utf-8\"))"
    },
    {
      "line_id": "text-files.production-v1.L022",
      "order": 22,
      "text": "            rendered = \"\".join(f\"{record['name']}:{record['score']}\\n\" for record in records)"
    },
    {
      "line_id": "text-files.production-v1.L023",
      "order": 23,
      "text": "            output.write_text(rendered, encoding=\"utf-8\", newline=\"\\n\")"
    },
    {
      "line_id": "text-files.production-v1.L024",
      "order": 24,
      "text": "            with output.open(\"a\", encoding=\"utf-8\", newline=\"\\n\") as handle: handle.write(fixture.get(\"append\", \"\"))"
    },
    {
      "line_id": "text-files.production-v1.L025",
      "order": 25,
      "text": "            trace += [{\"event\": \"load\", \"records\": len(records)}, {\"event\": \"overwrite\"}, {\"event\": \"append\"}]"
    },
    {
      "line_id": "text-files.production-v1.L026",
      "order": 26,
      "text": "            return {\"status\": \"OK\", \"records\": records, \"output\": output.read_text(encoding=\"utf-8\"), \"trace\": trace}"
    },
    {
      "line_id": "text-files.production-v1.L027",
      "order": 27,
      "text": "        except (OSError, UnicodeError, ValueError) as error:"
    },
    {
      "line_id": "text-files.production-v1.L028",
      "order": 28,
      "text": "            trace.append({\"event\": \"reject\", \"type\": type(error).__name__})"
    },
    {
      "line_id": "text-files.production-v1.L029",
      "order": 29,
      "text": "            return {\"status\": \"INVALID_FILE\", \"output\": output.read_text(encoding=\"utf-8\"), \"trace\": trace}"
    },
    {
      "line_id": "text-files.production-v1.L030",
      "order": 30,
      "text": ""
    },
    {
      "line_id": "text-files.production-v1.L031",
      "order": 31,
      "text": "if __name__ == \"__main__\":"
    },
    {
      "line_id": "text-files.production-v1.L032",
      "order": 32,
      "text": "    import json"
    },
    {
      "line_id": "text-files.production-v1.L033",
