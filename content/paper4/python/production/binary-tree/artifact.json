  "lines": [
    {
      "line_id": "binary-tree.production-v1.L001",
      "order": 1,
      "text": "from pathlib import Path"
    },
    {
      "line_id": "binary-tree.production-v1.L002",
      "order": 2,
      "text": ""
    },
    {
      "line_id": "binary-tree.production-v1.L003",
      "order": 3,
      "text": "class Node:"
    },
    {
      "line_id": "binary-tree.production-v1.L004",
      "order": 4,
      "text": "    def __init__(self, value): self.value, self.left, self.right = value, None, None"
    },
    {
      "line_id": "binary-tree.production-v1.L005",
      "order": 5,
      "text": ""
    },
    {
      "line_id": "binary-tree.production-v1.L006",
      "order": 6,
      "text": "def insert(root, value):"
    },
    {
      "line_id": "binary-tree.production-v1.L007",
      "order": 7,
      "text": "    if root is None: return Node(value), True"
    },
    {
      "line_id": "binary-tree.production-v1.L008",
      "order": 8,
      "text": "    current = root"
    },
    {
      "line_id": "binary-tree.production-v1.L009",
      "order": 9,
      "text": "    while True:"
    },
    {
      "line_id": "binary-tree.production-v1.L010",
      "order": 10,
      "text": "        if value == current.value: return root, False"
    },
    {
      "line_id": "binary-tree.production-v1.L011",
      "order": 11,
      "text": "        side = \"left\" if value < current.value else \"right\""
    },
    {
      "line_id": "binary-tree.production-v1.L012",
      "order": 12,
      "text": "        child = getattr(current, side)"
    },
    {
      "line_id": "binary-tree.production-v1.L013",
      "order": 13,
      "text": "        if child is None: setattr(current, side, Node(value)); return root, True"
    },
    {
      "line_id": "binary-tree.production-v1.L014",
      "order": 14,
      "text": "        current = child"
    },
    {
      "line_id": "binary-tree.production-v1.L015",
      "order": 15,
      "text": ""
    },
    {
      "line_id": "binary-tree.production-v1.L016",
      "order": 16,
      "text": "def traverse(node, order):"
    },
    {
      "line_id": "binary-tree.production-v1.L017",
      "order": 17,
      "text": "    if node is None: return []"
    },
    {
      "line_id": "binary-tree.production-v1.L018",
      "order": 18,
      "text": "    if order == \"pre\": return [node.value] + traverse(node.left, order) + traverse(node.right, order)"
    },
    {
      "line_id": "binary-tree.production-v1.L019",
      "order": 19,
      "text": "    if order == \"post\": return traverse(node.left, order) + traverse(node.right, order) + [node.value]"
    },
    {
      "line_id": "binary-tree.production-v1.L020",
      "order": 20,
      "text": "    return traverse(node.left, order) + [node.value] + traverse(node.right, order)"
    },
    {
      "line_id": "binary-tree.production-v1.L021",
      "order": 21,
      "text": ""
    },
    {
      "line_id": "binary-tree.production-v1.L022",
      "order": 22,
      "text": "def run(fixture):"
    },
    {
      "line_id": "binary-tree.production-v1.L023",
      "order": 23,
      "text": "    root, trace = None, []"
    },
    {
      "line_id": "binary-tree.production-v1.L024",
      "order": 24,
      "text": "    for value in fixture.get(\"values\", []):"
    },
    {
      "line_id": "binary-tree.production-v1.L025",
      "order": 25,
      "text": "        root, added = insert(root, value); trace.append({\"event\": \"insert\", \"value\": value, \"added\": added})"
    },
    {
      "line_id": "binary-tree.production-v1.L026",
      "order": 26,
      "text": "    before = traverse(root, \"in\")"
    },
    {
      "line_id": "binary-tree.production-v1.L027",
      "order": 27,
      "text": "    root, added = insert(root, fixture[\"insert\"])"
    },
    {
      "line_id": "binary-tree.production-v1.L028",
      "order": 28,
      "text": "    current, found = root, False"
    },
    {
      "line_id": "binary-tree.production-v1.L029",
      "order": 29,
      "text": "    while current is not None:"
    },
    {
      "line_id": "binary-tree.production-v1.L030",
      "order": 30,
      "text": "        trace.append({\"event\": \"search\", \"node\": current.value})"
    },
    {
      "line_id": "binary-tree.production-v1.L031",
      "order": 31,
      "text": "        if fixture[\"target\"] == current.value: found = True; break"
    },
    {
      "line_id": "binary-tree.production-v1.L032",
      "order": 32,
      "text": "        current = current.left if fixture[\"target\"] < current.value else current.right"
    },
    {
      "line_id": "binary-tree.production-v1.L033",
      "order": 33,
      "text": "    return {\"status\": \"FOUND\" if found else \"NOT_FOUND\", \"inserted\": added, \"unchanged_on_duplicate\": added or before == traverse(root, \"in\"), \"inorder\": traverse(root, \"in\"), \"preorder\": traverse(root, \"pre\"), \"postorder\": traverse(root, \"post\"), \"trace\": trace}"
    },
    {
      "line_id": "binary-tree.production-v1.L034",
      "order": 34,
      "text": ""
    },
    {
      "line_id": "binary-tree.production-v1.L035",
      "order": 35,
      "text": "if __name__ == \"__main__\":"
    },
    {
      "line_id": "binary-tree.production-v1.L036",
      "order": 36,
      "text": "    import json"
    },
    {
      "line_id": "binary-tree.production-v1.L037",
      "order": 37,
      "text": "    import sys"
    },
    {
      "line_id": "binary-tree.production-v1.L038",
      "order": 38,
      "text": "    fixture = json.loads(Path(sys.argv[1]).read_text(encoding=\"utf-8\"))"
    },
    {
      "line_id": "binary-tree.production-v1.L039",
      "order": 39,
      "text": "    result = run(fixture)"
    },
    {
      "line_id": "binary-tree.production-v1.L040",
      "order": 40,
      "text": "    if not result[\"trace\"]:"
    },
    {
      "line_id": "binary-tree.production-v1.L041",
      "order": 41,
      "text": "        result[\"trace\"].append({\"event\": \"complete_no_steps\"})"
    },
    {
      "line_id": "binary-tree.production-v1.L042",
      "order": 42,
      "text": "    print(json.dumps(result, ensure_ascii=False, sort_keys=True, separators=(\",\", \":\")))"
    },
    {
      "line_id": "binary-tree.production-v1.L043",
      "order": 43,
      "text": ""
    }
  ],
