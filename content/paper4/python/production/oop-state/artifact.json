      "text": ""
    },
    {
      "line_id": "oop-state.production-v1.L003",
      "order": 3,
      "text": "class Account:"
    },
    {
      "line_id": "oop-state.production-v1.L004",
      "order": 4,
      "text": "    def __init__(self, balance, limit): self.__balance, self.__limit = balance, limit"
    },
    {
      "line_id": "oop-state.production-v1.L005",
      "order": 5,
      "text": "    def get_balance(self): return self.__balance"
    },
    {
      "line_id": "oop-state.production-v1.L006",
      "order": 6,
      "text": "    def set_balance(self, value):"
    },
    {
      "line_id": "oop-state.production-v1.L007",
      "order": 7,
      "text": "        if not 0 <= value <= self.__limit: return False"
    },
    {
      "line_id": "oop-state.production-v1.L008",
      "order": 8,
      "text": "        self.__balance = value; return True"
    },
    {
      "line_id": "oop-state.production-v1.L009",
      "order": 9,
      "text": "    def apply_change(self, delta): return self.set_balance(self.__balance + delta)"
    },
    {
      "line_id": "oop-state.production-v1.L010",
      "order": 10,
      "text": ""
    },
    {
      "line_id": "oop-state.production-v1.L011",
      "order": 11,
      "text": "def run(fixture):"
    },
    {
      "line_id": "oop-state.production-v1.L012",
      "order": 12,
      "text": "    account, trace = Account(fixture[\"start\"], fixture[\"limit\"]), []"
    },
    {
      "line_id": "oop-state.production-v1.L013",
      "order": 13,
      "text": "    old = account.get_balance()"
    },
    {
      "line_id": "oop-state.production-v1.L014",
      "order": 14,
      "text": "    setter_ok = account.set_balance(fixture[\"replacement\"])"
    },
    {
      "line_id": "oop-state.production-v1.L015",
      "order": 15,
      "text": "    trace.append({\"event\": \"setter\", \"success\": setter_ok, \"balance\": account.get_balance()})"
    },
    {
      "line_id": "oop-state.production-v1.L016",
      "order": 16,
      "text": "    before_update = account.get_balance()"
    },
    {
      "line_id": "oop-state.production-v1.L017",
      "order": 17,
