  "lines": [
    {
      "line_id": "dictionary.production-v1.L001",
      "order": 1,
      "text": "from pathlib import Path"
    },
    {
      "line_id": "dictionary.production-v1.L002",
      "order": 2,
      "text": ""
    },
    {
      "line_id": "dictionary.production-v1.L003",
      "order": 3,
      "text": "class DictionaryADT:"
    },
    {
      "line_id": "dictionary.production-v1.L004",
      "order": 4,
      "text": "    def __init__(self): self.entries = []"
    },
    {
      "line_id": "dictionary.production-v1.L005",
      "order": 5,
      "text": "    def find(self, key):"
    },
    {
      "line_id": "dictionary.production-v1.L006",
      "order": 6,
      "text": "        return next((value for stored, value in self.entries if stored == key), None)"
    },
    {
      "line_id": "dictionary.production-v1.L007",
      "order": 7,
      "text": "    def insert(self, key, value):"
    },
    {
      "line_id": "dictionary.production-v1.L008",
      "order": 8,
      "text": "        if self.find(key) is not None: return False"
    },
    {
      "line_id": "dictionary.production-v1.L009",
      "order": 9,
      "text": "        self.entries.append([key, value]); return True"
    },
    {
      "line_id": "dictionary.production-v1.L010",
      "order": 10,
      "text": "    def delete(self, key):"
    },
    {
      "line_id": "dictionary.production-v1.L011",
      "order": 11,
      "text": "        for index, pair in enumerate(self.entries):"
    },
    {
      "line_id": "dictionary.production-v1.L012",
      "order": 12,
      "text": "            if pair[0] == key: self.entries.pop(index); return True"
    },
    {
      "line_id": "dictionary.production-v1.L013",
      "order": 13,
      "text": "        return False"
    },
    {
      "line_id": "dictionary.production-v1.L014",
      "order": 14,
      "text": ""
    },
    {
      "line_id": "dictionary.production-v1.L015",
      "order": 15,
      "text": "def run(fixture):"
    },
    {
      "line_id": "dictionary.production-v1.L016",
      "order": 16,
      "text": "    table, trace = DictionaryADT(), []"
    },
    {
      "line_id": "dictionary.production-v1.L017",
      "order": 17,
      "text": "    for key, value in fixture.get(\"initial\", []): table.insert(key, value)"
    },
    {
      "line_id": "dictionary.production-v1.L018",
      "order": 18,
      "text": "    before = [list(pair) for pair in table.entries]"
    },
    {
      "line_id": "dictionary.production-v1.L019",
      "order": 19,
      "text": "    inserted = table.insert(fixture[\"insert\"][0], fixture[\"insert\"][1])"
    },
    {
      "line_id": "dictionary.production-v1.L020",
      "order": 20,
      "text": "    deleted = table.delete(fixture[\"delete\"])"
    },
    {
      "line_id": "dictionary.production-v1.L021",
      "order": 21,
      "text": "    frequency = {}"
    },
    {
      "line_id": "dictionary.production-v1.L022",
      "order": 22,
      "text": "    for token in fixture.get(\"tokens\", []): frequency[token] = frequency.get(token, 0) + 1"
    },
    {
      "line_id": "dictionary.production-v1.L023",
      "order": 23,
      "text": "    trace += [{\"event\": \"insert\", \"success\": inserted}, {\"event\": \"delete\", \"success\": deleted}, {\"event\": \"aggregate\", \"groups\": len(frequency)}]"
    },
    {
      "line_id": "dictionary.production-v1.L024",
      "order": 24,
      "text": "    return {\"status\": \"OK\", \"before\": before, \"entries\": table.entries, \"inserted\": inserted, \"deleted\": deleted, \"found\": table.find(fixture[\"find\"]), \"frequency\": frequency, \"trace\": trace}"
    },
    {
      "line_id": "dictionary.production-v1.L025",
      "order": 25,
      "text": ""
    },
    {
      "line_id": "dictionary.production-v1.L026",
      "order": 26,
      "text": "if __name__ == \"__main__\":"
    },
    {
      "line_id": "dictionary.production-v1.L027",
      "order": 27,
      "text": "    import json"
    },
    {
      "line_id": "dictionary.production-v1.L028",
      "order": 28,
      "text": "    import sys"
    },
    {
      "line_id": "dictionary.production-v1.L029",
      "order": 29,
      "text": "    fixture = json.loads(Path(sys.argv[1]).read_text(encoding=\"utf-8\"))"
    },
    {
      "line_id": "dictionary.production-v1.L030",
      "order": 30,
      "text": "    result = run(fixture)"
    },
    {
      "line_id": "dictionary.production-v1.L031",
      "order": 31,
      "text": "    if not result[\"trace\"]:"
    },
    {
      "line_id": "dictionary.production-v1.L032",
      "order": 32,
      "text": "        result[\"trace\"].append({\"event\": \"complete_no_steps\"})"
    },
    {
      "line_id": "dictionary.production-v1.L033",
      "order": 33,
      "text": "    print(json.dumps(result, ensure_ascii=False, sort_keys=True, separators=(\",\", \":\")))"
    },
    {
      "line_id": "dictionary.production-v1.L034",
      "order": 34,
      "text": ""
    }
  ],
