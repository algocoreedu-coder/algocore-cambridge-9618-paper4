  "lines": [
    {
      "line_id": "recursion.v1.L001",
      "order": 1,
      "text": "import json"
    },
    {
      "line_id": "recursion.v1.L002",
      "order": 2,
      "text": "import sys"
    },
    {
      "line_id": "recursion.v1.L003",
      "order": 3,
      "text": ""
    },
    {
      "line_id": "recursion.v1.L004",
      "order": 4,
      "text": ""
    },
    {
      "line_id": "recursion.v1.L005",
      "order": 5,
      "text": "def recursive_sum(values, index, trace):"
    },
    {
      "line_id": "recursion.v1.L006",
      "order": 6,
      "text": "    trace.append({\"event\": \"call\", \"index\": index})"
    },
    {
      "line_id": "recursion.v1.L007",
      "order": 7,
      "text": "    if index == len(values):"
    },
    {
      "line_id": "recursion.v1.L008",
      "order": 8,
      "text": "        trace.append({\"event\": \"base_case\", \"index\": index, \"result\": 0})"
    },
    {
      "line_id": "recursion.v1.L009",
      "order": 9,
      "text": "        return 0"
    },
    {
      "line_id": "recursion.v1.L010",
      "order": 10,
      "text": "    subtotal = recursive_sum(values, index + 1, trace)"
    },
    {
      "line_id": "recursion.v1.L011",
      "order": 11,
      "text": "    result = values[index] + subtotal"
    },
    {
      "line_id": "recursion.v1.L012",
      "order": 12,
      "text": "    trace.append({\"event\": \"return\", \"index\": index, \"value\": values[index], \"result\": result})"
    },
    {
      "line_id": "recursion.v1.L013",
      "order": 13,
      "text": "    return result"
    },
    {
      "line_id": "recursion.v1.L014",
      "order": 14,
      "text": ""
    },
    {
      "line_id": "recursion.v1.L015",
      "order": 15,
      "text": ""
    },
    {
      "line_id": "recursion.v1.L016",
      "order": 16,
      "text": "def iterative_sum(values):"
    },
    {
      "line_id": "recursion.v1.L017",
      "order": 17,
      "text": "    total = 0"
    },
    {
      "line_id": "recursion.v1.L018",
      "order": 18,
      "text": "    for value in values:"
    },
    {
      "line_id": "recursion.v1.L019",
      "order": 19,
      "text": "        total += value"
    },
    {
      "line_id": "recursion.v1.L020",
      "order": 20,
      "text": "    return total"
    },
    {
      "line_id": "recursion.v1.L021",
      "order": 21,
      "text": ""
    },
    {
      "line_id": "recursion.v1.L022",
      "order": 22,
      "text": ""
    },
    {
      "line_id": "recursion.v1.L023",
      "order": 23,
      "text": "def run(fixture):"
    },
    {
      "line_id": "recursion.v1.L024",
      "order": 24,
      "text": "    values = fixture[\"values\"]"
    },
    {
      "line_id": "recursion.v1.L025",
      "order": 25,
      "text": "    trace = []"
    },
    {
      "line_id": "recursion.v1.L026",
      "order": 26,
      "text": "    if not all(isinstance(value, int) for value in values):"
    },
    {
      "line_id": "recursion.v1.L027",
      "order": 27,
      "text": "        trace.append({\"event\": \"reject_non_integer\"})"
    },
    {
      "line_id": "recursion.v1.L028",
      "order": 28,
      "text": "        return {\"status\": \"INVALID_VALUE\", \"trace\": trace}"
    },
    {
      "line_id": "recursion.v1.L029",
      "order": 29,
      "text": "    recursive_result = recursive_sum(values, 0, trace)"
    },
    {
      "line_id": "recursion.v1.L030",
      "order": 30,
      "text": "    iterative_result = iterative_sum(values)"
    },
    {
      "line_id": "recursion.v1.L031",
      "order": 31,
      "text": "    return {"
    },
    {
      "line_id": "recursion.v1.L032",
      "order": 32,
      "text": "        \"status\": \"OK\" if recursive_result == iterative_result else \"MISMATCH\","
    },
    {
      "line_id": "recursion.v1.L033",
      "order": 33,
      "text": "        \"recursive_result\": recursive_result,"
    },
    {
      "line_id": "recursion.v1.L034",
      "order": 34,
      "text": "        \"iterative_result\": iterative_result,"
    },
    {
      "line_id": "recursion.v1.L035",
      "order": 35,
      "text": "        \"trace\": trace,"
    },
    {
      "line_id": "recursion.v1.L036",
      "order": 36,
      "text": "    }"
    },
    {
      "line_id": "recursion.v1.L037",
      "order": 37,
      "text": ""
    },
    {
      "line_id": "recursion.v1.L038",
      "order": 38,
      "text": ""
    },
    {
      "line_id": "recursion.v1.L039",
      "order": 39,
      "text": "if __name__ == \"__main__\":"
    },
    {
      "line_id": "recursion.v1.L040",
      "order": 40,
      "text": "    with open(sys.argv[1], \"r\", encoding=\"utf-8\") as fixture_file:"
    },
    {
      "line_id": "recursion.v1.L041",
      "order": 41,
      "text": "        print(json.dumps(run(json.load(fixture_file)), ensure_ascii=False, sort_keys=True))"
    },
    {
