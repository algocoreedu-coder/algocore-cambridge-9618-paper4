  "language": "python",
  "lines": [
    {
      "line_id": "object-files.v1.L001",
      "order": 1,
      "text": "import csv"
    },
    {
      "line_id": "object-files.v1.L002",
      "order": 2,
      "text": "import json"
    },
    {
      "line_id": "object-files.v1.L003",
      "order": 3,
      "text": "import sys"
    },
    {
      "line_id": "object-files.v1.L004",
      "order": 4,
      "text": "from pathlib import Path"
    },
    {
      "line_id": "object-files.v1.L005",
      "order": 5,
      "text": ""
    },
    {
      "line_id": "object-files.v1.L006",
      "order": 6,
      "text": ""
    },
    {
      "line_id": "object-files.v1.L007",
      "order": 7,
      "text": "class Book:"
    },
    {
      "line_id": "object-files.v1.L008",
      "order": 8,
      "text": "    def __init__(self, title, pages):"
    },
    {
      "line_id": "object-files.v1.L009",
      "order": 9,
      "text": "        self.Title = title"
    },
    {
      "line_id": "object-files.v1.L010",
      "order": 10,
      "text": "        self.Pages = pages"
    },
    {
      "line_id": "object-files.v1.L011",
      "order": 11,
      "text": ""
    },
    {
      "line_id": "object-files.v1.L012",
      "order": 12,
      "text": "    def as_record(self):"
    },
    {
      "line_id": "object-files.v1.L054",
      "order": 13,
      "text": "        return {\"type\": \"BOOK\", \"title\": self.Title, \"pages\": self.Pages}"
    },
    {
      "line_id": "object-files.v1.L055",
      "order": 14,
      "text": ""
    },
    {
      "line_id": "object-files.v1.L056",
      "order": 15,
      "text": "    def set_pages(self, pages):"
    },
    {
      "line_id": "object-files.v1.L057",
      "order": 16,
      "text": "        if not isinstance(pages, int) or pages <= 0:"
    },
    {
      "line_id": "object-files.v1.L058",
      "order": 17,
      "text": "            return False"
    },
    {
      "line_id": "object-files.v1.L059",
      "order": 18,
      "text": "        self.Pages = pages"
    },
    {
      "line_id": "object-files.v1.L060",
      "order": 19,
      "text": "        return True"
    },
    {
      "line_id": "object-files.v1.L061",
      "order": 20,
      "text": ""
    },
    {
      "line_id": "object-files.v1.L062",
      "order": 21,
      "text": ""
    },
    {
      "line_id": "object-files.v1.L063",
      "order": 22,
      "text": "class EBook(Book):"
    },
    {
      "line_id": "object-files.v1.L064",
      "order": 23,
      "text": "    def __init__(self, title, pages, file_format):"
    },
    {
      "line_id": "object-files.v1.L065",
      "order": 24,
      "text": "        super().__init__(title, pages)"
    },
    {
      "line_id": "object-files.v1.L066",
      "order": 25,
      "text": "        self.FileFormat = file_format"
    },
    {
      "line_id": "object-files.v1.L067",
      "order": 26,
      "text": ""
    },
    {
      "line_id": "object-files.v1.L068",
      "order": 27,
      "text": "    def as_record(self):"
    },
    {
      "line_id": "object-files.v1.L069",
      "order": 28,
      "text": "        record = super().as_record()"
    },
    {
      "line_id": "object-files.v1.L070",
      "order": 29,
      "text": "        record[\"type\"] = \"EBOOK\""
    },
    {
      "line_id": "object-files.v1.L071",
      "order": 30,
      "text": "        record[\"file_format\"] = self.FileFormat"
    },
    {
      "line_id": "object-files.v1.L072",
      "order": 31,
      "text": "        return record"
    },
    {
      "line_id": "object-files.v1.L014",
      "order": 32,
      "text": ""
    },
    {
      "line_id": "object-files.v1.L015",
      "order": 33,
      "text": ""
    },
    {
      "line_id": "object-files.v1.L016",
      "order": 34,
      "text": "def read_books(csv_path, trace):"
    },
    {
      "line_id": "object-files.v1.L017",
      "order": 35,
      "text": "    books = []"
    },
    {
      "line_id": "object-files.v1.L018",
      "order": 36,
      "text": "    with open(csv_path, \"r\", encoding=\"utf-8\", newline=\"\") as csv_file:"
    },
    {
      "line_id": "object-files.v1.L019",
      "order": 37,
      "text": "        reader = csv.reader(csv_file)"
    },
    {
      "line_id": "object-files.v1.L020",
      "order": 38,
      "text": "        for line_number, fields in enumerate(reader, start=1):"
    },
    {
      "line_id": "object-files.v1.L021",
      "order": 39,
      "text": "            trace.append({\"event\": \"read_record\", \"line\": line_number, \"fields\": fields})"
    },
    {
      "line_id": "object-files.v1.L073",
      "order": 40,
      "text": "            if len(fields) < 3 or fields[1] == \"\":"
    },
    {
      "line_id": "object-files.v1.L023",
      "order": 41,
      "text": "                return None, f\"INVALID_RECORD_AT_LINE_{line_number}\""
    },
    {
      "line_id": "object-files.v1.L024",
      "order": 42,
      "text": "            try:"
    },
    {
      "line_id": "object-files.v1.L074",
      "order": 43,
      "text": "                pages = int(fields[2])"
    },
    {
      "line_id": "object-files.v1.L026",
      "order": 44,
      "text": "            except ValueError:"
    },
    {
      "line_id": "object-files.v1.L027",
      "order": 45,
      "text": "                return None, f\"INVALID_PAGES_AT_LINE_{line_number}\""
    },
    {
      "line_id": "object-files.v1.L075",
      "order": 46,
      "text": "            record_type = fields[0]"
    },
    {
      "line_id": "object-files.v1.L076",
      "order": 47,
      "text": "            if record_type == \"BOOK\" and len(fields) == 3:"
    },
    {
      "line_id": "object-files.v1.L077",
      "order": 48,
      "text": "                book = Book(fields[1], pages)"
    },
    {
      "line_id": "object-files.v1.L078",
      "order": 49,
      "text": "            elif record_type == \"EBOOK\" and len(fields) == 4:"
    },
    {
      "line_id": "object-files.v1.L079",
      "order": 50,
      "text": "                book = EBook(fields[1], pages, fields[3])"
    },
    {
      "line_id": "object-files.v1.L080",
      "order": 51,
      "text": "            else:"
    },
    {
      "line_id": "object-files.v1.L081",
      "order": 52,
      "text": "                return None, f\"INVALID_TYPE_AT_LINE_{line_number}\""
    },
    {
      "line_id": "object-files.v1.L082",
      "order": 53,
      "text": "            books.append(book)"
    },
    {
      "line_id": "object-files.v1.L083",
      "order": 54,
      "text": "            trace.append({\"event\": \"construct_object\", \"line\": line_number, \"type\": record_type, \"title\": fields[1]})"
    },
    {
      "line_id": "object-files.v1.L030",
      "order": 55,
      "text": "    return books, \"OK\""
    },
    {
      "line_id": "object-files.v1.L084",
      "order": 56,
      "text": ""
    },
    {
      "line_id": "object-files.v1.L085",
      "order": 57,
      "text": ""
    },
    {
      "line_id": "object-files.v1.L086",
      "order": 58,
      "text": "def lookup_and_update(books, title, new_pages, trace):"
    },
    {
      "line_id": "object-files.v1.L087",
      "order": 59,
      "text": "    for book in books:"
    },
    {
      "line_id": "object-files.v1.L088",
      "order": 60,
      "text": "        if book.Title == title:"
    },
    {
      "line_id": "object-files.v1.L089",
      "order": 61,
      "text": "            updated = book.set_pages(new_pages)"
    },
    {
      "line_id": "object-files.v1.L090",
      "order": 62,
      "text": "            trace.append({\"event\": \"update\", \"title\": title, \"new_pages\": new_pages, \"updated\": updated})"
    },
    {
      "line_id": "object-files.v1.L091",
      "order": 63,
      "text": "            return book, \"UPDATED\" if updated else \"INVALID_UPDATE\""
    },
    {
      "line_id": "object-files.v1.L092",
      "order": 64,
      "text": "    trace.append({\"event\": \"lookup_not_found\", \"title\": title})"
    },
    {
      "line_id": "object-files.v1.L093",
      "order": 65,
      "text": "    return None, \"NOT_FOUND\""
    },
    {
      "line_id": "object-files.v1.L031",
      "order": 66,
      "text": ""
    },
    {
      "line_id": "object-files.v1.L032",
      "order": 67,
      "text": ""
    },
    {
      "line_id": "object-files.v1.L033",
      "order": 68,
      "text": "def run(fixture, fixture_path):"
    },
    {
      "line_id": "object-files.v1.L034",
      "order": 69,
      "text": "    trace = []"
    },
    {
      "line_id": "object-files.v1.L035",
      "order": 70,
      "text": "    csv_path = Path(fixture_path).parent / fixture[\"csv_file\"]"
    },
    {
      "line_id": "object-files.v1.L036",
      "order": 71,
      "text": "    books, status = read_books(csv_path, trace)"
    },
    {
      "line_id": "object-files.v1.L037",
      "order": 72,
      "text": "    if books is None:"
    },
    {
      "line_id": "object-files.v1.L038",
      "order": 73,
      "text": "        return {\"status\": status, \"books\": [], \"trace\": trace}"
    },
    {
      "line_id": "object-files.v1.L094",
      "order": 74,
      "text": "    found, update_status = lookup_and_update(books, fixture[\"lookup_title\"], fixture[\"new_pages\"], trace)"
    },
    {
      "line_id": "object-files.v1.L095",
      "order": 75,
      "text": "    found_record = None if found is None else found.as_record()"
    },
    {
      "line_id": "object-files.v1.L096",
      "order": 76,
      "text": "    return {"
    },
    {
      "line_id": "object-files.v1.L097",
      "order": 77,
      "text": "        \"status\": update_status,"
    },
    {
      "line_id": "object-files.v1.L098",
      "order": 78,
      "text": "        \"books\": [book.as_record() for book in books],"
    },
    {
      "line_id": "object-files.v1.L099",
      "order": 79,
      "text": "        \"found\": found_record,"
    },
    {
      "line_id": "object-files.v1.L100",
      "order": 80,
      "text": "        \"trace\": trace,"
    },
    {
      "line_id": "object-files.v1.L101",
      "order": 81,
      "text": "    }"
    },
    {
      "line_id": "object-files.v1.L047",
      "order": 82,
      "text": ""
    },
    {
      "line_id": "object-files.v1.L048",
      "order": 83,
      "text": ""
    },
    {
      "line_id": "object-files.v1.L049",
      "order": 84,
      "text": "if __name__ == \"__main__\":"
    },
    {
      "line_id": "object-files.v1.L050",
      "order": 85,
      "text": "    fixture_path = sys.argv[1]"
    },
    {
      "line_id": "object-files.v1.L051",
      "order": 86,
      "text": "    with open(fixture_path, \"r\", encoding=\"utf-8\") as fixture_file:"
    },
    {
      "line_id": "object-files.v1.L052",
      "order": 87,
      "text": "        print(json.dumps(run(json.load(fixture_file), fixture_path), ensure_ascii=False, sort_keys=True))"
    },
    {
      "line_id": "object-files.v1.L053",
      "order": 88,
      "text": ""
    }
  ],
