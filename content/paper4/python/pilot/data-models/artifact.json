  "language": "python",
  "lines": [
    {
      "line_id": "data-models.v1.L001",
      "order": 1,
      "text": "import json"
    },
    {
      "line_id": "data-models.v1.L048",
      "order": 2,
      "text": "import random"
    },
    {
      "line_id": "data-models.v1.L002",
      "order": 3,
      "text": "import sys"
    },
    {
      "line_id": "data-models.v1.L003",
      "order": 4,
      "text": ""
    },
    {
      "line_id": "data-models.v1.L004",
      "order": 5,
      "text": ""
    },
    {
      "line_id": "data-models.v1.L005",
      "order": 6,
      "text": "def valid_record(record):"
    },
    {
      "line_id": "data-models.v1.L006",
      "order": 7,
      "text": "    return ("
    },
    {
      "line_id": "data-models.v1.L007",
      "order": 8,
      "text": "        isinstance(record, dict)"
    },
    {
      "line_id": "data-models.v1.L008",
      "order": 9,
      "text": "        and isinstance(record.get(\"name\"), str)"
    },
    {
      "line_id": "data-models.v1.L009",
      "order": 10,
      "text": "        and record[\"name\"] != \"\""
    },
    {
      "line_id": "data-models.v1.L049",
      "order": 11,
      "text": "        and type(record.get(\"score\")) is int"
    },
    {
      "line_id": "data-models.v1.L011",
      "order": 12,
      "text": "    )"
    },
    {
      "line_id": "data-models.v1.L012",
      "order": 13,
      "text": ""
    },
    {
      "line_id": "data-models.v1.L013",
      "order": 14,
      "text": ""
    },
    {
      "line_id": "data-models.v1.L014",
      "order": 15,
      "text": "def add_record(records, capacity, record, trace):"
    },
    {
      "line_id": "data-models.v1.L015",
      "order": 16,
      "text": "    trace.append({\"event\": \"check_record\", \"valid\": valid_record(record)})"
    },
    {
      "line_id": "data-models.v1.L016",
      "order": 17,
      "text": "    if not valid_record(record):"
    },
    {
      "line_id": "data-models.v1.L017",
      "order": 18,
      "text": "        return False, \"INVALID_RECORD\""
    },
    {
      "line_id": "data-models.v1.L018",
      "order": 19,
      "text": "    trace.append({\"event\": \"check_capacity\", \"count\": len(records), \"capacity\": capacity})"
    },
    {
      "line_id": "data-models.v1.L019",
      "order": 20,
      "text": "    if len(records) >= capacity:"
    },
    {
      "line_id": "data-models.v1.L020",
      "order": 21,
      "text": "        return False, \"FULL\""
    },
    {
      "line_id": "data-models.v1.L021",
      "order": 22,
      "text": "    records.append(record)"
    },
    {
      "line_id": "data-models.v1.L022",
      "order": 23,
      "text": "    trace.append({\"event\": \"append\", \"index\": len(records) - 1, \"record\": record})"
    },
    {
      "line_id": "data-models.v1.L023",
      "order": 24,
      "text": "    return True, \"ADDED\""
    },
    {
      "line_id": "data-models.v1.L024",
      "order": 25,
      "text": ""
    },
    {
      "line_id": "data-models.v1.L025",
      "order": 26,
      "text": ""
    },
    {
      "line_id": "data-models.v1.L050",
      "order": 27,
      "text": "def generate_random_array(count, lower, upper, seed, unique, trace):"
    },
    {
      "line_id": "data-models.v1.L051",
      "order": 28,
      "text": "    if count < 0 or lower > upper:"
    },
    {
      "line_id": "data-models.v1.L052",
      "order": 29,
      "text": "        raise ValueError(\"invalid random array contract\")"
    },
    {
      "line_id": "data-models.v1.L053",
      "order": 30,
      "text": "    if unique and count > upper - lower + 1:"
    },
    {
      "line_id": "data-models.v1.L054",
      "order": 31,
      "text": "        raise ValueError(\"random range is too small for unique values\")"
    },
    {
      "line_id": "data-models.v1.L055",
      "order": 32,
      "text": "    generator = random.Random(seed)"
    },
    {
      "line_id": "data-models.v1.L056",
      "order": 33,
      "text": "    values = []"
    },
    {
      "line_id": "data-models.v1.L057",
      "order": 34,
      "text": "    while len(values) < count:"
    },
    {
      "line_id": "data-models.v1.L058",
      "order": 35,
      "text": "        candidate = generator.randint(lower, upper)"
    },
    {
      "line_id": "data-models.v1.L059",
      "order": 36,
      "text": "        accepted = not unique or candidate not in values"
    },
    {
      "line_id": "data-models.v1.L060",
      "order": 37,
      "text": "        trace.append({\"event\": \"generate_random_value\", \"candidate\": candidate, \"accepted\": accepted})"
    },
    {
      "line_id": "data-models.v1.L061",
      "order": 38,
      "text": "        if accepted:"
    },
    {
      "line_id": "data-models.v1.L062",
      "order": 39,
      "text": "            values.append(candidate)"
    },
    {
      "line_id": "data-models.v1.L063",
      "order": 40,
      "text": "    return values"
    },
    {
      "line_id": "data-models.v1.L064",
      "order": 41,
      "text": ""
    },
    {
      "line_id": "data-models.v1.L065",
      "order": 42,
      "text": ""
    },
    {
      "line_id": "data-models.v1.L026",
      "order": 43,
      "text": "def run(fixture):"
    },
    {
      "line_id": "data-models.v1.L027",
      "order": 44,
      "text": "    records = [dict(record) for record in fixture[\"records\"]]"
    },
    {
      "line_id": "data-models.v1.L028",
      "order": 45,
      "text": "    trace = []"
    },
    {
      "line_id": "data-models.v1.L029",
      "order": 46,
      "text": "    added, message = add_record(records, fixture[\"capacity\"], fixture[\"new_record\"], trace)"
    },
    {
      "line_id": "data-models.v1.L066",
      "order": 47,
      "text": "    random_contract = fixture[\"random_contract\"]"
    },
    {
      "line_id": "data-models.v1.L067",
      "order": 48,
      "text": "    random_values = generate_random_array("
    },
    {
      "line_id": "data-models.v1.L068",
      "order": 49,
      "text": "        random_contract[\"count\"],"
    },
    {
      "line_id": "data-models.v1.L069",
      "order": 50,
      "text": "        random_contract[\"lower\"],"
    },
    {
      "line_id": "data-models.v1.L070",
      "order": 51,
      "text": "        random_contract[\"upper\"],"
    },
    {
      "line_id": "data-models.v1.L071",
      "order": 52,
      "text": "        random_contract[\"seed\"],"
    },
    {
      "line_id": "data-models.v1.L072",
      "order": 53,
      "text": "        random_contract.get(\"unique\", False),"
    },
    {
      "line_id": "data-models.v1.L073",
      "order": 54,
      "text": "        trace,"
    },
    {
      "line_id": "data-models.v1.L074",
      "order": 55,
      "text": "    )"
    },
    {
      "line_id": "data-models.v1.L031",
      "order": 56,
      "text": "    average = None"
    },
    {
      "line_id": "data-models.v1.L032",
      "order": 57,
      "text": "    if len(random_values) > 0:"
    },
    {
      "line_id": "data-models.v1.L033",
      "order": 58,
      "text": "        average = sum(random_values) / len(random_values)"
    },
    {
      "line_id": "data-models.v1.L034",
      "order": 59,
      "text": "    trace.append({\"event\": \"summarise_random_data\", \"count\": len(random_values), \"average\": average})"
    },
    {
      "line_id": "data-models.v1.L035",
      "order": 60,
      "text": "    return {"
    },
    {
      "line_id": "data-models.v1.L036",
      "order": 61,
      "text": "        \"status\": message,"
    },
    {
      "line_id": "data-models.v1.L037",
      "order": 62,
      "text": "        \"append_success\": added,"
    },
    {
      "line_id": "data-models.v1.L038",
      "order": 63,
      "text": "        \"records\": records,"
    },
    {
      "line_id": "data-models.v1.L075",
      "order": 64,
      "text": "        \"random_values\": random_values,"
    },
    {
      "line_id": "data-models.v1.L039",
      "order": 65,
      "text": "        \"random_average\": average,"
    },
    {
      "line_id": "data-models.v1.L040",
      "order": 66,
      "text": "        \"trace\": trace,"
    },
    {
      "line_id": "data-models.v1.L041",
      "order": 67,
      "text": "    }"
    },
    {
      "line_id": "data-models.v1.L042",
      "order": 68,
      "text": ""
    },
    {
      "line_id": "data-models.v1.L043",
      "order": 69,
      "text": ""
    },
    {
      "line_id": "data-models.v1.L044",
      "order": 70,
      "text": "if __name__ == \"__main__\":"
    },
    {
      "line_id": "data-models.v1.L045",
      "order": 71,
      "text": "    with open(sys.argv[1], \"r\", encoding=\"utf-8\") as fixture_file:"
    },
    {
      "line_id": "data-models.v1.L046",
      "order": 72,
      "text": "        print(json.dumps(run(json.load(fixture_file)), ensure_ascii=False, sort_keys=True))"
    },
    {
      "line_id": "data-models.v1.L047",
      "order": 73,
      "text": ""
    }
  ],
