  "language": "python",
  "lines": [
    {
      "line_id": "queue.v1.L001",
      "order": 1,
      "text": "import json"
    },
    {
      "line_id": "queue.v1.L002",
      "order": 2,
      "text": "import sys"
    },
    {
      "line_id": "queue.v1.L003",
      "order": 3,
      "text": ""
    },
    {
      "line_id": "queue.v1.L004",
      "order": 4,
      "text": ""
    },
    {
      "line_id": "queue.v1.L005",
      "order": 5,
      "text": "class CircularQueue:"
    },
    {
      "line_id": "queue.v1.L006",
      "order": 6,
      "text": "    def __init__(self, capacity, trace):"
    },
    {
      "line_id": "queue.v1.L007",
      "order": 7,
      "text": "        if capacity <= 0:"
    },
    {
      "line_id": "queue.v1.L008",
      "order": 8,
      "text": "            trace.append({\"event\": \"reject_invalid_capacity\", \"capacity\": capacity})"
    },
    {
      "line_id": "queue.v1.L009",
      "order": 9,
      "text": "            raise ValueError(\"capacity must be positive\")"
    },
    {
      "line_id": "queue.v1.L010",
      "order": 10,
      "text": "        self.items = [None] * capacity"
    },
    {
      "line_id": "queue.v1.L011",
      "order": 11,
      "text": "        self.front = 0"
    },
    {
      "line_id": "queue.v1.L012",
      "order": 12,
      "text": "        self.rear = 0"
    },
    {
      "line_id": "queue.v1.L013",
      "order": 13,
      "text": "        self.count = 0"
    },
    {
      "line_id": "queue.v1.L014",
      "order": 14,
      "text": "        self.trace = trace"
    },
    {
      "line_id": "queue.v1.L015",
      "order": 15,
      "text": ""
    },
    {
      "line_id": "queue.v1.L016",
      "order": 16,
      "text": "    def enqueue(self, item):"
    },
    {
      "line_id": "queue.v1.L017",
      "order": 17,
      "text": "        self.trace.append({\"event\": \"check_full\", \"count\": self.count, \"capacity\": len(self.items)})"
    },
    {
      "line_id": "queue.v1.L018",
      "order": 18,
      "text": "        if self.count == len(self.items):"
    },
    {
      "line_id": "queue.v1.L019",
      "order": 19,
      "text": "            return False"
    },
    {
      "line_id": "queue.v1.L020",
      "order": 20,
      "text": "        insert_index = self.rear"
    },
    {
      "line_id": "queue.v1.L021",
      "order": 21,
      "text": "        self.items[insert_index] = item"
    },
    {
      "line_id": "queue.v1.L022",
      "order": 22,
      "text": "        self.rear = (self.rear + 1) % len(self.items)"
    },
    {
      "line_id": "queue.v1.L023",
      "order": 23,
      "text": "        self.count += 1"
    },
    {
      "line_id": "queue.v1.L024",
      "order": 24,
      "text": "        self.trace.append({\"event\": \"enqueue\", \"index\": insert_index, \"item\": item})"
    },
    {
      "line_id": "queue.v1.L025",
      "order": 25,
      "text": "        return True"
    },
    {
      "line_id": "queue.v1.L026",
      "order": 26,
      "text": ""
    },
    {
      "line_id": "queue.v1.L027",
      "order": 27,
      "text": "    def dequeue(self):"
    },
    {
      "line_id": "queue.v1.L028",
      "order": 28,
      "text": "        self.trace.append({\"event\": \"check_empty\", \"count\": self.count})"
    },
    {
      "line_id": "queue.v1.L029",
      "order": 29,
      "text": "        if self.count == 0:"
    },
    {
      "line_id": "queue.v1.L030",
      "order": 30,
      "text": "            return None"
    },
    {
      "line_id": "queue.v1.L031",
      "order": 31,
      "text": "        remove_index = self.front"
    },
    {
      "line_id": "queue.v1.L032",
      "order": 32,
      "text": "        item = self.items[remove_index]"
    },
    {
      "line_id": "queue.v1.L033",
      "order": 33,
      "text": "        self.items[remove_index] = None"
    },
    {
      "line_id": "queue.v1.L034",
      "order": 34,
      "text": "        self.front = (self.front + 1) % len(self.items)"
    },
    {
      "line_id": "queue.v1.L035",
      "order": 35,
      "text": "        self.count -= 1"
    },
    {
      "line_id": "queue.v1.L036",
      "order": 36,
      "text": "        self.trace.append({\"event\": \"dequeue\", \"index\": remove_index, \"item\": item})"
    },
    {
      "line_id": "queue.v1.L037",
      "order": 37,
      "text": "        return item"
    },
    {
      "line_id": "queue.v1.L038",
      "order": 38,
      "text": ""
    },
    {
      "line_id": "queue.v1.L039",
      "order": 39,
      "text": "    def live_items(self):"
    },
    {
      "line_id": "queue.v1.L040",
      "order": 40,
      "text": "        values = []"
    },
    {
      "line_id": "queue.v1.L041",
      "order": 41,
      "text": "        for offset in range(self.count):"
    },
    {
      "line_id": "queue.v1.L042",
      "order": 42,
      "text": "            values.append(self.items[(self.front + offset) % len(self.items)])"
    },
    {
      "line_id": "queue.v1.L043",
      "order": 43,
      "text": "        self.trace.append({\"event\": \"inspect\", \"values\": values})"
    },
    {
      "line_id": "queue.v1.L044",
      "order": 44,
      "text": "        return values"
    },
    {
      "line_id": "queue.v1.L045",
      "order": 45,
      "text": ""
    },
    {
      "line_id": "queue.v1.L046",
      "order": 46,
      "text": ""
    },
    {
      "line_id": "queue.v1.L047",
      "order": 47,
      "text": "def run(fixture):"
    },
    {
      "line_id": "queue.v1.L048",
      "order": 48,
      "text": "    trace = []"
    },
    {
      "line_id": "queue.v1.L049",
      "order": 49,
      "text": "    try:"
    },
    {
      "line_id": "queue.v1.L050",
      "order": 50,
      "text": "        queue = CircularQueue(fixture[\"capacity\"], trace)"
    },
    {
      "line_id": "queue.v1.L051",
      "order": 51,
      "text": "    except ValueError as error:"
    },
    {
      "line_id": "queue.v1.L052",
      "order": 52,
      "text": "        return {\"status\": \"INVALID_CAPACITY\", \"message\": str(error), \"trace\": trace}"
    },
    {
      "line_id": "queue.v1.L053",
      "order": 53,
      "text": "    removed = []"
    },
    {
      "line_id": "queue.v1.L054",
      "order": 54,
      "text": "    operation_results = []"
    },
    {
      "line_id": "queue.v1.L055",
      "order": 55,
      "text": "    for operation in fixture[\"operations\"]:"
    },
    {
      "line_id": "queue.v1.L056",
      "order": 56,
      "text": "        if operation[0] == \"enqueue\":"
    },
    {
      "line_id": "queue.v1.L057",
      "order": 57,
      "text": "            operation_results.append(queue.enqueue(operation[1]))"
    },
    {
      "line_id": "queue.v1.L058",
      "order": 58,
      "text": "        elif operation[0] == \"dequeue\":"
    },
    {
      "line_id": "queue.v1.L059",
      "order": 59,
      "text": "            removed.append(queue.dequeue())"
    },
    {
      "line_id": "queue.v1.L060",
      "order": 60,
      "text": "        else:"
    },
    {
      "line_id": "queue.v1.L061",
      "order": 61,
      "text": "            return {\"status\": \"UNKNOWN_OPERATION\", \"operation\": operation[0], \"trace\": trace}"
    },
    {
      "line_id": "queue.v1.L062",
      "order": 62,
      "text": "    live = queue.live_items()"
    },
    {
      "line_id": "queue.v1.L063",
      "order": 63,
      "text": "    numeric_total = sum(item for item in live if isinstance(item, (int, float)))"
    },
    {
      "line_id": "queue.v1.L064",
      "order": 64,
      "text": "    return {"
    },
    {
      "line_id": "queue.v1.L065",
      "order": 65,
      "text": "        \"status\": \"OK\","
    },
    {
      "line_id": "queue.v1.L066",
      "order": 66,
      "text": "        \"operation_results\": operation_results,"
    },
    {
      "line_id": "queue.v1.L067",
      "order": 67,
      "text": "        \"removed\": removed,"
    },
    {
      "line_id": "queue.v1.L068",
      "order": 68,
      "text": "        \"live\": live,"
    },
    {
      "line_id": "queue.v1.L069",
      "order": 69,
      "text": "        \"numeric_total\": numeric_total,"
    },
    {
      "line_id": "queue.v1.L070",
      "order": 70,
      "text": "        \"front\": queue.front,"
    },
    {
      "line_id": "queue.v1.L071",
      "order": 71,
      "text": "        \"rear\": queue.rear,"
    },
    {
      "line_id": "queue.v1.L072",
      "order": 72,
      "text": "        \"count\": queue.count,"
    },
    {
      "line_id": "queue.v1.L073",
      "order": 73,
      "text": "        \"trace\": trace,"
    },
    {
      "line_id": "queue.v1.L074",
      "order": 74,
      "text": "    }"
    },
    {
      "line_id": "queue.v1.L075",
      "order": 75,
      "text": ""
    },
    {
      "line_id": "queue.v1.L076",
      "order": 76,
      "text": ""
    },
    {
      "line_id": "queue.v1.L077",
      "order": 77,
      "text": "if __name__ == \"__main__\":"
    },
    {
      "line_id": "queue.v1.L078",
      "order": 78,
      "text": "    with open(sys.argv[1], \"r\", encoding=\"utf-8\") as fixture_file:"
    },
    {
      "line_id": "queue.v1.L079",
      "order": 79,
      "text": "        print(json.dumps(run(json.load(fixture_file)), ensure_ascii=False, sort_keys=True))"
    },
    {
      "line_id": "queue.v1.L080",
      "order": 80,
      "text": ""
    }
  ],
