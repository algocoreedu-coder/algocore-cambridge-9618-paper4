  "lines": [
    {
      "line_id": "oop-aggregation.production-v1.L001",
      "order": 1,
      "text": "from pathlib import Path"
    },
    {
      "line_id": "oop-aggregation.production-v1.L002",
      "order": 2,
      "text": ""
    },
    {
      "line_id": "oop-aggregation.production-v1.L003",
      "order": 3,
      "text": "class Book:"
    },
    {
      "line_id": "oop-aggregation.production-v1.L004",
      "order": 4,
      "text": "    def __init__(self, title): self.title = title"
    },
    {
      "line_id": "oop-aggregation.production-v1.L005",
      "order": 5,
      "text": "    def label(self): return self.title.upper()"
    },
    {
      "line_id": "oop-aggregation.production-v1.L006",
      "order": 6,
      "text": "class Shelf:"
    },
    {
      "line_id": "oop-aggregation.production-v1.L007",
      "order": 7,
      "text": "    def __init__(self, capacity): self.capacity, self.books = capacity, []"
    },
    {
      "line_id": "oop-aggregation.production-v1.L008",
      "order": 8,
      "text": "    def add(self, book):"
    },
    {
      "line_id": "oop-aggregation.production-v1.L009",
      "order": 9,
      "text": "        if not isinstance(book, Book) or len(self.books) == self.capacity: return False"
    },
    {
      "line_id": "oop-aggregation.production-v1.L010",
      "order": 10,
      "text": "        self.books.append(book); return True"
    },
    {
      "line_id": "oop-aggregation.production-v1.L011",
      "order": 11,
      "text": "    def labels(self): return [book.label() for book in self.books]"
    },
    {
      "line_id": "oop-aggregation.production-v1.L012",
      "order": 12,
      "text": ""
    },
    {
      "line_id": "oop-aggregation.production-v1.L013",
      "order": 13,
      "text": "def run(fixture):"
    },
    {
      "line_id": "oop-aggregation.production-v1.L014",
      "order": 14,
      "text": "    shelf, trace = Shelf(fixture[\"capacity\"]), []"
    },
    {
      "line_id": "oop-aggregation.production-v1.L015",
      "order": 15,
      "text": "    for value in fixture.get(\"items\", []):"
    },
    {
      "line_id": "oop-aggregation.production-v1.L016",
      "order": 16,
      "text": "        item = Book(value) if isinstance(value, str) else value"
    },
    {
      "line_id": "oop-aggregation.production-v1.L017",
      "order": 17,
      "text": "        before = len(shelf.books); success = shelf.add(item)"
    },
    {
      "line_id": "oop-aggregation.production-v1.L018",
      "order": 18,
      "text": "        trace.append({\"event\": \"bounded_add\", \"success\": success, \"count\": len(shelf.books), \"unchanged_on_reject\": success or before == len(shelf.books)})"
    },
    {
      "line_id": "oop-aggregation.production-v1.L019",
      "order": 19,
      "text": "    return {\"status\": \"OK\", \"count\": len(shelf.books), \"labels\": shelf.labels(), \"capacity\": shelf.capacity, \"trace\": trace}"
    },
    {
      "line_id": "oop-aggregation.production-v1.L020",
      "order": 20,
      "text": ""
    },
    {
      "line_id": "oop-aggregation.production-v1.L021",
      "order": 21,
      "text": "if __name__ == \"__main__\":"
    },
    {
      "line_id": "oop-aggregation.production-v1.L022",
      "order": 22,
      "text": "    import json"
    },
    {
      "line_id": "oop-aggregation.production-v1.L023",
      "order": 23,
      "text": "    import sys"
    },
    {
      "line_id": "oop-aggregation.production-v1.L024",
      "order": 24,
      "text": "    fixture = json.loads(Path(sys.argv[1]).read_text(encoding=\"utf-8\"))"
    },
    {
      "line_id": "oop-aggregation.production-v1.L025",
      "order": 25,
      "text": "    result = run(fixture)"
    },
    {
      "line_id": "oop-aggregation.production-v1.L026",
      "order": 26,
      "text": "    if not result[\"trace\"]:"
    },
    {
      "line_id": "oop-aggregation.production-v1.L027",
      "order": 27,
      "text": "        result[\"trace\"].append({\"event\": \"complete_no_steps\"})"
    },
