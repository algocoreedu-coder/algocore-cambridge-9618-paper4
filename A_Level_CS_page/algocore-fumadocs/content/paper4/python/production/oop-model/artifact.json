    {
      "line_id": "oop-model.production-v1.L011",
      "order": 11,
      "text": "    objects, rejected, trace = [], 0, []"
    },
    {
      "line_id": "oop-model.production-v1.L012",
      "order": 12,
      "text": "    for record in fixture.get(\"records\", []):"
    },
    {
      "line_id": "oop-model.production-v1.L013",
      "order": 13,
      "text": "        try:"
    },
    {
      "line_id": "oop-model.production-v1.L014",
      "order": 14,
      "text": "            student = Student(record.get(\"student_id\"), record.get(\"name\", \"\"), record.get(\"score\", 0))"
    },
    {
      "line_id": "oop-model.production-v1.L015",
      "order": 15,
      "text": "            objects.append(student); trace.append({\"event\": \"instantiate\", \"student_id\": student.student_id})"
    },
    {
      "line_id": "oop-model.production-v1.L016",
      "order": 16,
      "text": "        except (TypeError, ValueError):"
    },
