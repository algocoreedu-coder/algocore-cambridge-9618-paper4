    {
      "line_id": "sorting.production-v1.L029",
      "order": 29,
      "text": "    if not all(isinstance(value, int) for value in values):"
    },
    {
      "line_id": "sorting.production-v1.L030",
      "order": 30,
      "text": "        return {\"status\": \"INVALID_KEY\", \"values\": values, \"trace\": [{\"event\": \"reject_key\"}]}"
    },
    {
      "line_id": "sorting.production-v1.L031",
      "order": 31,
      "text": "    ordered, comparisons, swaps = bubble(values, fixture.get(\"reverse\", False))"
    },
    {
      "line_id": "sorting.production-v1.L032",
      "order": 32,
      "text": "    insertion_ordered = insertion(values)"
