      "order": 33,
      "text": "    bounded = list(fixture.get(\"bounded\", []))"
    },
    {
      "line_id": "sorting.production-v1.L034",
      "order": 34,
      "text": "    if len(bounded) >= fixture[\"capacity\"]:"
    },
    {
      "line_id": "sorting.production-v1.L035",
      "order": 35,
      "text": "        return {\"status\": \"FULL\", \"values\": bounded, \"bubble\": ordered, \"insertion\": insertion_ordered, \"trace\": [{\"event\": \"capacity_reject\"}]}"
    },
    {
      "line_id": "sorting.production-v1.L036",
      "order": 36,
      "text": "    item = fixture[\"insert\"]"
    },
    {
      "line_id": "sorting.production-v1.L037",
      "order": 37,
      "text": "    position = 0"
    },
    {
      "line_id": "sorting.production-v1.L038",
      "order": 38,
