  "lines": [
    {
      "line_id": "sorting.production-v1.L001",
      "order": 1,
      "text": "from pathlib import Path"
    },
    {
      "line_id": "sorting.production-v1.L002",
      "order": 2,
      "text": ""
    },
    {
      "line_id": "sorting.production-v1.L003",
      "order": 3,
      "text": "def bubble(values, reverse=False):"
    },
    {
      "line_id": "sorting.production-v1.L004",
      "order": 4,
      "text": "    output, comparisons, swaps = list(values), 0, 0"
    },
    {
      "line_id": "sorting.production-v1.L005",
      "order": 5,
      "text": "    for end in range(len(output) - 1, 0, -1):"
    },
    {
      "line_id": "sorting.production-v1.L006",
      "order": 6,
      "text": "        changed = False"
    },
    {
      "line_id": "sorting.production-v1.L007",
      "order": 7,
      "text": "        for index in range(end):"
    },
    {
      "line_id": "sorting.production-v1.L008",
      "order": 8,
      "text": "            comparisons += 1"
    },
    {
      "line_id": "sorting.production-v1.L009",
      "order": 9,
      "text": "            wrong = output[index] < output[index + 1] if reverse else output[index] > output[index + 1]"
    },
    {
      "line_id": "sorting.production-v1.L010",
      "order": 10,
      "text": "            if wrong:"
    },
    {
      "line_id": "sorting.production-v1.L011",
      "order": 11,
      "text": "                output[index], output[index + 1] = output[index + 1], output[index]"
    },
    {
      "line_id": "sorting.production-v1.L012",
      "order": 12,
      "text": "                swaps, changed = swaps + 1, True"
    },
    {
      "line_id": "sorting.production-v1.L013",
      "order": 13,
      "text": "        if not changed:"
    },
    {
      "line_id": "sorting.production-v1.L014",
      "order": 14,
      "text": "            break"
    },
    {
      "line_id": "sorting.production-v1.L015",
      "order": 15,
      "text": "    return output, comparisons, swaps"
    },
    {
      "line_id": "sorting.production-v1.L016",
      "order": 16,
      "text": ""
    },
    {
      "line_id": "sorting.production-v1.L017",
      "order": 17,
      "text": "def insertion(values):"
    },
    {
      "line_id": "sorting.production-v1.L018",
      "order": 18,
      "text": "    output = list(values)"
    },
    {
      "line_id": "sorting.production-v1.L019",
      "order": 19,
      "text": "    for index in range(1, len(output)):"
    },
    {
      "line_id": "sorting.production-v1.L020",
      "order": 20,
      "text": "        item, position = output[index], index"
    },
    {
      "line_id": "sorting.production-v1.L021",
      "order": 21,
      "text": "        while position > 0 and output[position - 1] > item:"
    },
    {
      "line_id": "sorting.production-v1.L022",
      "order": 22,
      "text": "            output[position] = output[position - 1]"
    },
    {
      "line_id": "sorting.production-v1.L023",
      "order": 23,
      "text": "            position -= 1"
    },
    {
      "line_id": "sorting.production-v1.L024",
      "order": 24,
      "text": "        output[position] = item"
    },
    {
      "line_id": "sorting.production-v1.L025",
      "order": 25,
      "text": "    return output"
    },
    {
      "line_id": "sorting.production-v1.L026",
      "order": 26,
      "text": ""
    },
    {
      "line_id": "sorting.production-v1.L027",
      "order": 27,
      "text": "def run(fixture):"
