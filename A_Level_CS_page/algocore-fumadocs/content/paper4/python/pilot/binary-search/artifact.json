  "lines": [
    {
      "line_id": "binary-search.v1.L001",
      "order": 1,
      "text": "import json"
    },
    {
      "line_id": "binary-search.v1.L002",
      "order": 2,
      "text": "import sys"
    },
    {
      "line_id": "binary-search.v1.L003",
      "order": 3,
      "text": ""
    },
    {
      "line_id": "binary-search.v1.L004",
      "order": 4,
      "text": ""
    },
    {
      "line_id": "binary-search.v1.L005",
      "order": 5,
      "text": "def is_ascending(values):"
    },
    {
      "line_id": "binary-search.v1.L006",
      "order": 6,
      "text": "    for index in range(1, len(values)):"
    },
    {
      "line_id": "binary-search.v1.L007",
      "order": 7,
      "text": "        if values[index - 1] > values[index]:"
    },
    {
      "line_id": "binary-search.v1.L008",
      "order": 8,
      "text": "            return False"
    },
    {
      "line_id": "binary-search.v1.L009",
      "order": 9,
      "text": "    return True"
    },
    {
      "line_id": "binary-search.v1.L010",
      "order": 10,
      "text": ""
    },
    {
      "line_id": "binary-search.v1.L011",
      "order": 11,
      "text": ""
    },
    {
      "line_id": "binary-search.v1.L012",
      "order": 12,
      "text": "def binary_search(values, target, trace):"
    },
    {
      "line_id": "binary-search.v1.L013",
      "order": 13,
      "text": "    low = 0"
    },
    {
      "line_id": "binary-search.v1.L014",
      "order": 14,
      "text": "    high = len(values) - 1"
    },
    {
      "line_id": "binary-search.v1.L015",
      "order": 15,
      "text": "    while low <= high:"
    },
    {
      "line_id": "binary-search.v1.L016",
      "order": 16,
      "text": "        middle = (low + high) // 2"
    },
    {
      "line_id": "binary-search.v1.L017",
      "order": 17,
      "text": "        trace.append({"
    },
    {
      "line_id": "binary-search.v1.L018",
      "order": 18,
      "text": "            \"event\": \"inspect_middle\","
    },
    {
      "line_id": "binary-search.v1.L019",
      "order": 19,
      "text": "            \"low\": low,"
    },
    {
      "line_id": "binary-search.v1.L020",
      "order": 20,
      "text": "            \"high\": high,"
    },
    {
      "line_id": "binary-search.v1.L021",
      "order": 21,
      "text": "            \"middle\": middle,"
    },
    {
      "line_id": "binary-search.v1.L022",
      "order": 22,
      "text": "            \"value\": values[middle],"
    },
    {
      "line_id": "binary-search.v1.L023",
      "order": 23,
      "text": "        })"
    },
    {
      "line_id": "binary-search.v1.L024",
      "order": 24,
      "text": "        if values[middle] == target:"
    },
    {
      "line_id": "binary-search.v1.L025",
      "order": 25,
      "text": "            return middle"
    },
    {
      "line_id": "binary-search.v1.L026",
      "order": 26,
      "text": "        if target < values[middle]:"
    },
    {
      "line_id": "binary-search.v1.L027",
      "order": 27,
      "text": "            high = middle - 1"
    },
    {
      "line_id": "binary-search.v1.L028",
      "order": 28,
      "text": "        else:"
    },
    {
      "line_id": "binary-search.v1.L029",
      "order": 29,
      "text": "            low = middle + 1"
    },
    {
      "line_id": "binary-search.v1.L030",
      "order": 30,
      "text": "    trace.append({\"event\": \"search_exhausted\", \"low\": low, \"high\": high})"
    },
    {
      "line_id": "binary-search.v1.L031",
      "order": 31,
      "text": "    return -1"
    },
    {
      "line_id": "binary-search.v1.L032",
      "order": 32,
      "text": ""
    },
    {
      "line_id": "binary-search.v1.L033",
      "order": 33,
      "text": ""
    },
    {
      "line_id": "binary-search.v1.L048",
      "order": 34,
      "text": "def recursive_binary_search(values, target, low, high, trace):"
    },
    {
      "line_id": "binary-search.v1.L049",
      "order": 35,
      "text": "    trace.append({\"event\": \"recursive_call\", \"low\": low, \"high\": high})"
    },
    {
      "line_id": "binary-search.v1.L050",
      "order": 36,
      "text": "    if low > high:"
    },
    {
      "line_id": "binary-search.v1.L051",
      "order": 37,
      "text": "        trace.append({\"event\": \"recursive_base_not_found\", \"low\": low, \"high\": high})"
    },
    {
      "line_id": "binary-search.v1.L052",
      "order": 38,
      "text": "        return -1"
    },
    {
      "line_id": "binary-search.v1.L053",
      "order": 39,
      "text": "    middle = (low + high) // 2"
    },
    {
      "line_id": "binary-search.v1.L054",
      "order": 40,
      "text": "    trace.append({\"event\": \"recursive_inspect\", \"middle\": middle, \"value\": values[middle]})"
    },
    {
      "line_id": "binary-search.v1.L055",
      "order": 41,
      "text": "    if values[middle] == target:"
    },
    {
      "line_id": "binary-search.v1.L056",
      "order": 42,
      "text": "        return middle"
    },
    {
      "line_id": "binary-search.v1.L057",
      "order": 43,
      "text": "    if target < values[middle]:"
    },
    {
      "line_id": "binary-search.v1.L058",
      "order": 44,
      "text": "        trace.append({\"event\": \"recursive_progress_left\", \"next_low\": low, \"next_high\": middle - 1})"
    },
    {
      "line_id": "binary-search.v1.L059",
      "order": 45,
      "text": "        return recursive_binary_search(values, target, low, middle - 1, trace)"
    },
    {
      "line_id": "binary-search.v1.L060",
      "order": 46,
      "text": "    trace.append({\"event\": \"recursive_progress_right\", \"next_low\": middle + 1, \"next_high\": high})"
    },
    {
      "line_id": "binary-search.v1.L061",
      "order": 47,
      "text": "    return recursive_binary_search(values, target, middle + 1, high, trace)"
    },
    {
      "line_id": "binary-search.v1.L062",
      "order": 48,
      "text": ""
    },
    {
      "line_id": "binary-search.v1.L063",
      "order": 49,
      "text": ""
    },
    {
      "line_id": "binary-search.v1.L034",
      "order": 50,
      "text": "def run(fixture):"
    },
    {
      "line_id": "binary-search.v1.L035",
      "order": 51,
      "text": "    values = fixture[\"values\"]"
    },
    {
      "line_id": "binary-search.v1.L036",
      "order": 52,
      "text": "    trace = []"
    },
    {
      "line_id": "binary-search.v1.L037",
      "order": 53,
      "text": "    if not is_ascending(values):"
    },
    {
      "line_id": "binary-search.v1.L038",
      "order": 54,
      "text": "        trace.append({\"event\": \"reject_unsorted_input\"})"
    },
    {
      "line_id": "binary-search.v1.L039",
      "order": 55,
      "text": "        return {\"status\": \"UNSORTED\", \"index\": -1, \"trace\": trace}"
    },
    {
      "line_id": "binary-search.v1.L064",
      "order": 56,
      "text": "    iterative_index = binary_search(values, fixture[\"target\"], trace)"
    },
    {
      "line_id": "binary-search.v1.L065",
      "order": 57,
      "text": "    recursive_index = recursive_binary_search(values, fixture[\"target\"], 0, len(values) - 1, trace)"
    },
    {
      "line_id": "binary-search.v1.L066",
      "order": 58,
      "text": "    if iterative_index != recursive_index:"
    },
    {
      "line_id": "binary-search.v1.L067",
      "order": 59,
      "text": "        return {\"status\": \"MISMATCH\", \"index\": iterative_index, \"recursive_index\": recursive_index, \"trace\": trace}"
    },
    {
      "line_id": "binary-search.v1.L068",
      "order": 60,
      "text": "    return {"
    },
    {
      "line_id": "binary-search.v1.L069",
      "order": 61,
      "text": "        \"status\": \"FOUND\" if iterative_index != -1 else \"NOT_FOUND\","
    },
    {
      "line_id": "binary-search.v1.L070",
      "order": 62,
      "text": "        \"index\": iterative_index,"
    },
    {
      "line_id": "binary-search.v1.L071",
      "order": 63,
      "text": "        \"recursive_index\": recursive_index,"
    },
    {
      "line_id": "binary-search.v1.L072",
      "order": 64,
      "text": "        \"trace\": trace,"
    },
    {
      "line_id": "binary-search.v1.L073",
      "order": 65,
      "text": "    }"
    },
    {
      "line_id": "binary-search.v1.L042",
      "order": 66,
      "text": ""
    },
    {
      "line_id": "binary-search.v1.L043",
      "order": 67,
      "text": ""
    },
    {
      "line_id": "binary-search.v1.L044",
      "order": 68,
      "text": "if __name__ == \"__main__\":"
    },
    {
      "line_id": "binary-search.v1.L045",
      "order": 69,
      "text": "    with open(sys.argv[1], \"r\", encoding=\"utf-8\") as fixture_file:"
    },
    {
      "line_id": "binary-search.v1.L046",
      "order": 70,
      "text": "        print(json.dumps(run(json.load(fixture_file)), ensure_ascii=False, sort_keys=True))"
    },
    {
      "line_id": "binary-search.v1.L047",
      "order": 71,
      "text": ""
    }
  ],
