  "lines": [
    {
      "line_id": "hashing.v1.L001",
      "order": 1,
      "text": "import json"
    },
    {
      "line_id": "hashing.v1.L002",
      "order": 2,
      "text": "import sys"
    },
    {
      "line_id": "hashing.v1.L003",
      "order": 3,
      "text": ""
    },
    {
      "line_id": "hashing.v1.L004",
      "order": 4,
      "text": ""
    },
    {
      "line_id": "hashing.v1.L005",
      "order": 5,
      "text": "class HashTable:"
    },
    {
      "line_id": "hashing.v1.L006",
      "order": 6,
      "text": "    def __init__(self, size, trace):"
    },
    {
      "line_id": "hashing.v1.L007",
      "order": 7,
      "text": "        if size <= 0:"
    },
    {
      "line_id": "hashing.v1.L008",
      "order": 8,
      "text": "            raise ValueError(\"size must be positive\")"
    },
    {
      "line_id": "hashing.v1.L009",
      "order": 9,
      "text": "        self.slots = [None] * size"
    },
    {
      "line_id": "hashing.v1.L010",
      "order": 10,
      "text": "        self.trace = trace"
    },
    {
      "line_id": "hashing.v1.L011",
      "order": 11,
      "text": ""
    },
    {
      "line_id": "hashing.v1.L012",
      "order": 12,
      "text": "    def address(self, key):"
    },
    {
      "line_id": "hashing.v1.L013",
      "order": 13,
      "text": "        return key % len(self.slots)"
    },
    {
      "line_id": "hashing.v1.L014",
      "order": 14,
      "text": ""
    },
    {
      "line_id": "hashing.v1.L015",
      "order": 15,
      "text": "    def insert(self, key):"
    },
    {
      "line_id": "hashing.v1.L016",
      "order": 16,
      "text": "        start = self.address(key)"
    },
    {
      "line_id": "hashing.v1.L017",
      "order": 17,
      "text": "        for step in range(len(self.slots)):"
    },
    {
      "line_id": "hashing.v1.L018",
      "order": 18,
      "text": "            index = (start + step) % len(self.slots)"
    },
    {
      "line_id": "hashing.v1.L019",
      "order": 19,
      "text": "            self.trace.append({\"event\": \"probe_insert\", \"key\": key, \"index\": index, \"step\": step})"
    },
    {
      "line_id": "hashing.v1.L020",
      "order": 20,
      "text": "            if self.slots[index] is None:"
    },
    {
      "line_id": "hashing.v1.L021",
      "order": 21,
      "text": "                self.slots[index] = key"
    },
    {
      "line_id": "hashing.v1.L022",
      "order": 22,
      "text": "                return index"
    },
    {
      "line_id": "hashing.v1.L023",
      "order": 23,
      "text": "            if self.slots[index] == key:"
    },
    {
      "line_id": "hashing.v1.L024",
      "order": 24,
      "text": "                return index"
    },
    {
      "line_id": "hashing.v1.L025",
      "order": 25,
      "text": "        return -1"
    },
    {
      "line_id": "hashing.v1.L026",
      "order": 26,
      "text": ""
    },
    {
      "line_id": "hashing.v1.L027",
      "order": 27,
      "text": "    def search(self, key):"
    },
    {
      "line_id": "hashing.v1.L028",
      "order": 28,
      "text": "        start = self.address(key)"
    },
    {
      "line_id": "hashing.v1.L029",
      "order": 29,
      "text": "        for step in range(len(self.slots)):"
    },
    {
      "line_id": "hashing.v1.L030",
      "order": 30,
      "text": "            index = (start + step) % len(self.slots)"
    },
    {
      "line_id": "hashing.v1.L031",
      "order": 31,
      "text": "            self.trace.append({\"event\": \"probe_search\", \"key\": key, \"index\": index, \"step\": step})"
    },
    {
      "line_id": "hashing.v1.L032",
      "order": 32,
      "text": "            if self.slots[index] is None:"
    },
    {
      "line_id": "hashing.v1.L033",
      "order": 33,
      "text": "                return -1"
    },
    {
      "line_id": "hashing.v1.L034",
      "order": 34,
      "text": "            if self.slots[index] == key:"
    },
    {
      "line_id": "hashing.v1.L035",
      "order": 35,
      "text": "                return index"
    },
    {
      "line_id": "hashing.v1.L036",
      "order": 36,
      "text": "        return -1"
    },
    {
      "line_id": "hashing.v1.L037",
      "order": 37,
      "text": ""
    },
    {
      "line_id": "hashing.v1.L038",
      "order": 38,
      "text": ""
    },
    {
      "line_id": "hashing.v1.L039",
      "order": 39,
      "text": "def run(fixture):"
    },
    {
      "line_id": "hashing.v1.L040",
      "order": 40,
      "text": "    trace = []"
    },
    {
      "line_id": "hashing.v1.L041",
      "order": 41,
      "text": "    if not all(isinstance(key, int) for key in fixture[\"insert_keys\"] + [fixture[\"search_key\"]]):"
    },
    {
      "line_id": "hashing.v1.L042",
      "order": 42,
      "text": "        trace.append({\"event\": \"reject_non_integer_key\"})"
    },
    {
      "line_id": "hashing.v1.L043",
      "order": 43,
      "text": "        return {\"status\": \"INVALID_KEY\", \"trace\": trace}"
    },
    {
      "line_id": "hashing.v1.L044",
      "order": 44,
      "text": "    try:"
    },
    {
      "line_id": "hashing.v1.L045",
      "order": 45,
      "text": "        table = HashTable(fixture[\"size\"], trace)"
    },
    {
      "line_id": "hashing.v1.L046",
      "order": 46,
      "text": "    except ValueError as error:"
    },
    {
      "line_id": "hashing.v1.L047",
      "order": 47,
      "text": "        return {\"status\": \"INVALID_SIZE\", \"message\": str(error), \"trace\": trace}"
    },
    {
      "line_id": "hashing.v1.L048",
      "order": 48,
      "text": "    inserted_at = []"
    },
    {
      "line_id": "hashing.v1.L049",
      "order": 49,
      "text": "    for key in fixture[\"insert_keys\"]:"
    },
    {
      "line_id": "hashing.v1.L050",
      "order": 50,
      "text": "        inserted_at.append(table.insert(key))"
    },
    {
      "line_id": "hashing.v1.L051",
      "order": 51,
      "text": "    found_at = table.search(fixture[\"search_key\"])"
    },
    {
      "line_id": "hashing.v1.L052",
      "order": 52,
      "text": "    return {"
    },
    {
      "line_id": "hashing.v1.L053",
      "order": 53,
      "text": "        \"status\": \"OK\","
    },
    {
      "line_id": "hashing.v1.L054",
      "order": 54,
      "text": "        \"inserted_at\": inserted_at,"
    },
    {
      "line_id": "hashing.v1.L055",
      "order": 55,
      "text": "        \"found_at\": found_at,"
    },
    {
      "line_id": "hashing.v1.L056",
      "order": 56,
      "text": "        \"slots\": table.slots,"
    },
    {
      "line_id": "hashing.v1.L057",
      "order": 57,
      "text": "        \"trace\": trace,"
    },
    {
      "line_id": "hashing.v1.L058",
      "order": 58,
      "text": "    }"
    },
    {
      "line_id": "hashing.v1.L059",
      "order": 59,
      "text": ""
    },
    {
      "line_id": "hashing.v1.L060",
      "order": 60,
      "text": ""
    },
    {
      "line_id": "hashing.v1.L061",
      "order": 61,
      "text": "if __name__ == \"__main__\":"
    },
    {
      "line_id": "hashing.v1.L062",
      "order": 62,
      "text": "    with open(sys.argv[1], \"r\", encoding=\"utf-8\") as fixture_file:"
    },
    {
      "line_id": "hashing.v1.L063",
      "order": 63,
      "text": "        print(json.dumps(run(json.load(fixture_file)), ensure_ascii=False, sort_keys=True))"
    },
    {
