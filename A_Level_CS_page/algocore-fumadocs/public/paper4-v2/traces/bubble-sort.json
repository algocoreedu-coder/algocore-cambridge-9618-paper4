    "lines": [
      {
        "line_id": "sorting.production-v1.L001",
        "order": 1,
        "text": "from pathlib import Path"
      },
      {
        "line_id": "sorting.production-v1.L002",
        "order": 2,
        "text": ""
      },
      {
        "line_id": "sorting.production-v1.L003",
        "order": 3,
        "text": "def bubble(values, reverse=False):"
      },
      {
        "line_id": "sorting.production-v1.L004",
        "order": 4,
        "text": "    output, comparisons, swaps = list(values), 0, 0"
      },
      {
        "line_id": "sorting.production-v1.L005",
        "order": 5,
        "text": "    for end in range(len(output) - 1, 0, -1):"
      },
      {
        "line_id": "sorting.production-v1.L006",
        "order": 6,
        "text": "        changed = False"
      },
      {
        "line_id": "sorting.production-v1.L007",
        "order": 7,
        "text": "        for index in range(end):"
      },
      {
        "line_id": "sorting.production-v1.L008",
        "order": 8,
        "text": "            comparisons += 1"
      },
      {
        "line_id": "sorting.production-v1.L009",
        "order": 9,
        "text": "            wrong = output[index] < output[index + 1] if reverse else output[index] > output[index + 1]"
      },
      {
        "line_id": "sorting.production-v1.L010",
        "order": 10,
        "text": "            if wrong:"
      },
      {
        "line_id": "sorting.production-v1.L011",
        "order": 11,
        "text": "                output[index], output[index + 1] = output[index + 1], output[index]"
      },
      {
        "line_id": "sorting.production-v1.L012",
        "order": 12,
        "text": "                swaps, changed = swaps + 1, True"
      },
      {
        "line_id": "sorting.production-v1.L013",
        "order": 13,
        "text": "        if not changed:"
      },
      {
        "line_id": "sorting.production-v1.L014",
        "order": 14,
        "text": "            break"
      },
      {
        "line_id": "sorting.production-v1.L015",
        "order": 15,
        "text": "    return output, comparisons, swaps"
      },
      {
        "line_id": "sorting.production-v1.L016",
        "order": 16,
        "text": ""
      },
      {
        "line_id": "sorting.production-v1.L017",
        "order": 17,
        "text": "def insertion(values):"
      },
      {
        "line_id": "sorting.production-v1.L018",
        "order": 18,
        "text": "    output = list(values)"
      },
      {
        "line_id": "sorting.production-v1.L019",
        "order": 19,
        "text": "    for index in range(1, len(output)):"
      },
      {
        "line_id": "sorting.production-v1.L020",
        "order": 20,
        "text": "        item, position = output[index], index"
      },
      {
        "line_id": "sorting.production-v1.L021",
        "order": 21,
        "text": "        while position > 0 and output[position - 1] > item:"
      },
      {
        "line_id": "sorting.production-v1.L022",
        "order": 22,
        "text": "            output[position] = output[position - 1]"
      },
      {
        "line_id": "sorting.production-v1.L023",
        "order": 23,
        "text": "            position -= 1"
      },
      {
        "line_id": "sorting.production-v1.L024",
        "order": 24,
        "text": "        output[position] = item"
      },
      {
        "line_id": "sorting.production-v1.L025",
        "order": 25,
        "text": "    return output"
      },
      {
        "line_id": "sorting.production-v1.L026",
        "order": 26,
        "text": ""
      },
      {
        "line_id": "sorting.production-v1.L027",
        "order": 27,
        "text": "def run(fixture):"
      },
      {
        "line_id": "sorting.production-v1.L028",
        "order": 28,
        "text": "    values = fixture.get(\"values\", [])"
      },
      {
        "line_id": "sorting.production-v1.L029",
        "order": 29,
        "text": "    if not all(isinstance(value, int) for value in values):"
      },
      {
        "line_id": "sorting.production-v1.L030",
        "order": 30,
        "text": "        return {\"status\": \"INVALID_KEY\", \"values\": values, \"trace\": [{\"event\": \"reject_key\"}]}"
      },
      {
        "line_id": "sorting.production-v1.L031",
        "order": 31,
        "text": "    ordered, comparisons, swaps = bubble(values, fixture.get(\"reverse\", False))"
      },
      {
        "line_id": "sorting.production-v1.L032",
        "order": 32,
        "text": "    insertion_ordered = insertion(values)"
      },
      {
        "line_id": "sorting.production-v1.L033",
        "order": 33,
        "text": "    bounded = list(fixture.get(\"bounded\", []))"
      },
      {
        "line_id": "sorting.production-v1.L034",
        "order": 34,
        "text": "    if len(bounded) >= fixture[\"capacity\"]:"
      },
      {
        "line_id": "sorting.production-v1.L035",
        "order": 35,
        "text": "        return {\"status\": \"FULL\", \"values\": bounded, \"bubble\": ordered, \"insertion\": insertion_ordered, \"trace\": [{\"event\": \"capacity_reject\"}]}"
      },
      {
        "line_id": "sorting.production-v1.L036",
        "order": 36,
        "text": "    item = fixture[\"insert\"]"
      },
      {
        "line_id": "sorting.production-v1.L037",
        "order": 37,
        "text": "    position = 0"
      },
      {
        "line_id": "sorting.production-v1.L038",
        "order": 38,
        "text": "    while position < len(bounded) and bounded[position] <= item:"
      },
      {
        "line_id": "sorting.production-v1.L039",
        "order": 39,
        "text": "        position += 1"
      },
      {
        "line_id": "sorting.production-v1.L040",
        "order": 40,
        "text": "    bounded.insert(position, item)"
      },
      {
        "line_id": "sorting.production-v1.L041",
        "order": 41,
        "text": "    return {\"status\": \"OK\", \"bubble\": ordered, \"insertion\": insertion_ordered, \"bounded\": bounded, \"comparisons\": comparisons, \"swaps\": swaps, \"trace\": [{\"event\": \"bubble_complete\"}, {\"event\": \"ordered_insert\", \"position\": position}]}"
      },
      {
        "line_id": "sorting.production-v1.L042",
        "order": 42,
        "text": ""
      },
      {
        "line_id": "sorting.production-v1.L043",
        "order": 43,
        "text": "if __name__ == \"__main__\":"
      },
      {
        "line_id": "sorting.production-v1.L044",
        "order": 44,
        "text": "    import json"
      },
      {
        "line_id": "sorting.production-v1.L045",
        "order": 45,
        "text": "    import sys"
      },
      {
        "line_id": "sorting.production-v1.L046",
        "order": 46,
        "text": "    fixture = json.loads(Path(sys.argv[1]).read_text(encoding=\"utf-8\"))"
      },
      {
        "line_id": "sorting.production-v1.L047",
        "order": 47,
        "text": "    result = run(fixture)"
      },
      {
        "line_id": "sorting.production-v1.L048",
        "order": 48,
        "text": "    if not result[\"trace\"]:"
      },
      {
        "line_id": "sorting.production-v1.L049",
        "order": 49,
        "text": "        result[\"trace\"].append({\"event\": \"complete_no_steps\"})"
      },
      {
        "line_id": "sorting.production-v1.L050",
        "order": 50,
        "text": "    print(json.dumps(result, ensure_ascii=False, sort_keys=True, separators=(\",\", \":\")))"
      },
      {
        "line_id": "sorting.production-v1.L051",
        "order": 51,
        "text": ""
      }
    ],
