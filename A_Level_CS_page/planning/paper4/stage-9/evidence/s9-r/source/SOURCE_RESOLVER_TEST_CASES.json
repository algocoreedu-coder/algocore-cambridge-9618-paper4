{
  "schema_version": "1.0.0",
  "test_cases": [
    {
      "id": "SRC-WINDOWS-LOCATOR",
      "input": {
        "authority": "official_qp",
        "source_id": "9618_s24_41_qp",
        "locator": "D:\\Private\\corpus\\9618_s24_41_qp.pdf#page=3",
        "status": "VERIFIED_STAGE1"
      },
      "expected_access_mode": "internal-citation",
      "expected_external_href": null,
      "reason": "A Windows locator is provenance text and never a public href."
    },
    {
      "id": "SRC-RELATIVE-LOCATOR",
      "input": {
        "authority": "coursebook",
        "source_id": "BOOK-10-ARRAYS",
        "locator": "stage-3/LESSON_PACKAGES.json#lessons[array-basics]",
        "status": "VERIFIED_STAGE3"
      },
      "expected_access_mode": "internal-citation",
      "expected_external_href": null,
      "reason": "A repository-relative locator remains citation text."
    },
    {
      "id": "SRC-VERIFIED-EXTERNAL",
      "input": {
        "authority": "AlgoCore_policy",
        "source_id": "CAMBRIDGE-2026-UPDATE",
        "locator": "stage-0/SOURCE_BASELINE.md#Evidence trực tiếp của Lead",
        "accessMode": "verified-external",
        "externalUrl": "https://www.cambridgeinternational.org/Images/747145-2026-syllabus-update.pdf",
        "status": "VERIFIED_EXTERNAL"
      },
      "expected_access_mode": "verified-external",
      "expected_external_href": "https://www.cambridgeinternational.org/Images/747145-2026-syllabus-update.pdf",
      "reason": "Explicit mode, verified status, and a dedicated HTTPS URL are all present."
    },
    {
      "id": "SRC-UNVERIFIED-EXTERNAL-DOWNGRADE",
      "input": {
        "authority": "AlgoCore_policy",
        "source_id": "PENDING-WEB-SOURCE",
        "accessMode": "verified-external",
        "externalUrl": "https://example.invalid/pending",
        "status": "PENDING_REVIEW"
      },
      "expected_access_mode": "internal-citation",
      "expected_external_href": null,
      "reason": "An HTTPS string alone is insufficient without verified status or flag."
    },
    {
      "id": "SRC-LOCATOR-LOOKS-LIKE-URL",
      "input": {
        "authority": "stage1_source_caveat_carryover",
        "source_id": "CAVEAT-01",
        "locator": "https://example.invalid/not-a-published-url",
        "status": "VERIFIED_STAGE1"
      },
      "expected_access_mode": "internal-citation",
      "expected_external_href": null,
      "reason": "The locator field is never promoted to href, even when its text resembles a URL."
    }
  ]
}
