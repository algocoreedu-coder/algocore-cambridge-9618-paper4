  "variants": [
    {
      "variant_id": "b6.variant.class-constructor",
      "pattern_ids": [
        "OOP_CLASS"
      ],
      "stage2_contrast_refs": [],
      "axis": "visibility_parameter_mapping_defaults",
      "decision_rule": {
        "vi": "Từ class table tạo map field/type/visibility/source-of-value.",
        "en": "Build a field/type/visibility/value-source map from the class table."
      },
      "cases": [
        {
          "case_id": "all_parameters",
          "signature": "every field supplied",
          "initialisation": "parameter→matching field"
        },
        {
          "case_id": "parameters_plus_defaults",
          "signature": "some fields omitted",
          "initialisation": "parameter fields plus stated defaults"
        },
        {
          "case_id": "composition_or_array",
          "signature": "container field",
          "initialisation": "distinct child/default element per required slot"
        }
      ],
      "invariant": "Immediately after construction every required field exists once, with exact identifier and source-defined value.",
      "method_changing": true
    },
    {
      "variant_id": "b6.variant.subclass-construction",
      "pattern_ids": [
        "OOP_SUBCLASS"
      ],
      "stage2_contrast_refs": [],
      "axis": "parent_new_attributes_super_call",
      "decision_rule": {
        "vi": "Chia parameters thành parent slice và subclass slice trước super call.",
        "en": "Partition parameters into parent and subclass slices before the super call."
      },
      "cases": [
        {
          "case_id": "parent_plus_one_field",
          "order": "super(parent args), then one subclass assignment"
        },
        {
          "case_id": "parent_plus_multiple_fields",
          "order": "super(parent args), then each new field exactly once"
        }
      ],
      "invariant": "Parent invariant holds after super; subclass invariant holds after new-field initialisation.",
      "method_changing": true
    },
    {
      "variant_id": "b6.variant.getter-member",
      "pattern_ids": [
        "OOP_GET"
      ],
      "stage2_contrast_refs": [],
      "axis": "scalar_or_indexed_member",
      "decision_rule": {
        "vi": "Chọn stored member và optional index từ method contract.",
        "en": "Select the stored member and optional index from the method contract."
      },
      "cases": [
        {
          "case_id": "scalar",
          "parameters": "none besides instance",
          "return": "one stored scalar"
        },
        {
          "case_id": "indexed",
          "parameters": "source index",
          "return": "stored element at exact index"
        }
      ],
      "invariant": "Getter returns stored value/type and leaves the entire object unchanged.",
      "method_changing": true
    },
    {
      "variant_id": "b6.variant.set-versus-update",
      "pattern_ids": [
        "OOP_SET",
        "OOP_UPDATE"
      ],
      "stage2_contrast_refs": [
        "A3C06"
      ],
      "axis": "replacement_or_rule_transition",
      "decision_rule": {
        "vi": "Dùng equation: không có field_before là Set; có field_before/formula/bound là Update.",
        "en": "Use the equation: no field_before means Set; field_before/formula/bound means Update."
      },
      "cases": [
        {
          "case_id": "direct_set",
          "equation": "field_after=parameter"
        },
        {
          "case_id": "relative_add",
          "equation": "field_after=field_before+delta"
        },
        {
          "case_id": "bounded_or_scaled",
          "equation": "field_after=clamp_or_scale(field_before, parameter)"
        },
        {
          "case_id": "indexed_derived",
          "equation": "member[index]=formula(parameters, fields)"
        }
      ],
      "invariant": "Only named targets change; after-state satisfies the exact source equation and bounds.",
      "method_changing": true
    },
    {
      "variant_id": "b6.variant.override-strategy",
      "pattern_ids": [
        "OOP_OVERRIDE"
      ],
      "stage2_contrast_refs": [],
      "axis": "parent_call_subclass_rule_result",
      "decision_rule": {
        "vi": "Tính parent side effects rồi chọn call/extend/reimplement strategy để mỗi obligation xảy ra đúng một lần.",
        "en": "Count parent side effects, then choose call/extend/reimplement so every obligation occurs once."
      },
      "cases": [
        {
          "case_id": "transform_then_super",
          "example": "bonus-adjusted hours passed to parent SetPay"
        },
        {
          "case_id": "specialised_state_rule",
          "example": "movement/element rule replaces parent behaviour"
        },
        {
          "case_id": "extend_result",
          "example": "parent description plus subclass text"
        }
      ],
      "invariant": "Same callable contract dispatches to subclass behaviour without duplicate parent side effects.",
      "method_changing": true
    },
    {
      "variant_id": "b6.variant.instantiate-source",
      "pattern_ids": [
        "OOP_INSTANTIATE"
      ],
      "stage2_contrast_refs": [],
      "axis": "fixed_input_file_single_array_composition",
      "decision_rule": {
        "vi": "Map one complete source record/fixed tuple to one constructor call and one storage destination.",
        "en": "Map one complete source record/fixed tuple to one constructor call and one storage destination."
      },
      "cases": [
        {
          "case_id": "fixed_single",
          "source": "literal tuple",
          "destination": "named object"
        },
        {
          "case_id": "interactive",
          "source": "validated/input tuple",
          "destination": "single or array slot"
        },
        {
          "case_id": "file_records",
          "source": "one complete grouped record",
          "destination": "next object slot"
        },
        {
          "case_id": "nested_grid",
          "source": "default child tuple",
          "destination": "distinct instance per grid cell"
        }
      ],
      "invariant": "After k source tuples exactly k valid, correctly typed object instances are reachable in required positions.",
      "method_changing": true
    },
    {
      "variant_id": "b6.variant.capacity-add",
      "pattern_ids": [
        "OOP_CAPACITY_ADD"
      ],
      "stage2_contrast_refs": [],
      "axis": "capacity_count_return",
      "decision_rule": {
        "vi": "Dùng count làm next-free slot và capacity làm full boundary trong observed Station contract.",
        "en": "Use count as next-free slot and capacity as full boundary in the observed Station contract."
      },
      "cases": [
        {
          "case_id": "space",
          "guard": "count<capacity",
          "transition": "storage[count]=object; count+=1; True"
        },
        {
          "case_id": "full",
          "guard": "count==capacity",
          "transition": "no mutation; False"
        }
      ],
      "invariant": "0<=count<=capacity; success adds the exact object once and failure preserves all state.",
      "method_changing": true
    }
  ],
