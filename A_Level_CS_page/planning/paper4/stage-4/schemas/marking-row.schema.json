{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://algocore.local/schemas/paper4-stage4/marking-row-v1.json",
  "type": "object",
  "required": ["part_id", "paper_id", "question_id", "pattern_ids", "official_part_marks", "qp_requirements", "marking_points", "part_disposition", "review_status"],
  "properties": {
    "part_id": {"type": "string"}, "paper_id": {"type": "string"}, "question_id": {"type": "string"},
    "pattern_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
    "official_part_marks": {"type": "integer", "minimum": 0},
    "qp_requirements": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["requirement_id", "paraphrase", "source_id", "pdf_pages", "authority"], "properties": {"requirement_id": {"type": "string"}, "paraphrase": {"type": "string"}, "source_id": {"type": "string"}, "pdf_pages": {"type": "array", "minItems": 1, "items": {"type": "integer"}}, "authority": {"const": "official_qp"}}}},
    "marking_points": {"type": "array", "items": {"type": "object", "required": ["marking_point_id", "ms_source_id", "ms_pdf_pages", "criterion_paraphrase", "authority", "award_semantics", "source_mark_value_if_unambiguous", "method_step_refs"], "properties": {"marking_point_id": {"type": "string"}, "ms_source_id": {"type": "string"}, "ms_pdf_pages": {"type": "array", "minItems": 1, "items": {"type": "integer"}}, "criterion_paraphrase": {"type": "string"}, "authority": {"const": "official_ms"}, "award_semantics": {"enum": ["discrete", "group_max", "alternative", "dependent", "holistic", "evidence", "accept_equivalent"]}, "source_mark_value_if_unambiguous": {"type": ["integer", "null"], "minimum": 0}, "method_step_refs": {"type": "array", "items": {"type": "string"}}}}},
    "part_disposition": {"enum": ["MAPPED", "HOLISTIC_PART_LEVEL", "NO_SEPARATE_POINT", "EVIDENCE_ONLY", "BLOCKED_SOURCE"]},
    "review_status": {"enum": ["SUBMITTED", "NEEDS_REWORK", "LEAD_REVIEWED", "CLOSED_VERIFIED"]}
  }
}
