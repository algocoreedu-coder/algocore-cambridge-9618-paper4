{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://algocore.local/schemas/paper4-stage4/design-briefs-v1.json",
  "type": "object",
  "required": ["solution_designs", "assessment_designs", "visual_briefs"],
  "properties": {
    "solution_designs": {"type": "array", "minItems": 58, "items": {"type": "object", "required": ["solution_design_id", "pattern_id", "input_contract", "output_contract", "state_model", "preconditions", "postconditions", "invariants", "ordered_method_step_ids", "stage5_test_obligations", "status"], "properties": {"status": {"const": "PENDING_STAGE5_EXECUTION_VERIFICATION"}}}},
    "assessment_designs": {"type": "array", "minItems": 37, "items": {"type": "object", "required": ["assessment_id", "requirement_ids", "objective_ids", "knowledge_block_ids", "origin", "task_intent", "observable_evidence", "progression", "rubric_dimensions", "status"], "properties": {"status": {"const": "DESIGNED_NOT_AUTHORED"}, "official_marks": {"type": "null"}}}},
    "visual_briefs": {"type": "array", "minItems": 58, "items": {"type": "object", "required": ["visual_brief_id", "pattern_id", "method_step_refs", "learning_question", "visual_mode", "state_to_show", "proposed_event_types", "predict_prompt", "static_fallback", "status"], "properties": {"visual_mode": {"enum": ["event_driven", "static", "comparison"]}, "status": {"const": "PENDING_STAGE5_TRACE_AND_STAGE7_STORYBOARD"}}}}
  }
}
