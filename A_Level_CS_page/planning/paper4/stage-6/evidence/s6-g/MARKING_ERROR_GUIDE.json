          "likely_error": {
            "vi": "Gọi output/search/transform trước producer hoặc dùng state version cũ.",
            "en": "Calling output/search/transform before its producer or using a stale state version."
          },
          "consequence": {
            "vi": "Call nhận state rỗng/cũ và workflow cho kết quả sai dù không lỗi cú pháp.",
            "en": "A call consumes empty/stale state and the workflow is wrong without a syntax failure."
          },
          "detection_check": {
            "vi": "Gắn version number vào state sau mỗi mutation và kiểm mọi call đọc latest producer.",
            "en": "Attach a version number after every state mutation and verify every call reads the latest producer."
          },
          "repair_action": {
            "vi": "Sắp lại topological order theo dependency edges; truyền trực tiếp latest result/state.",
            "en": "Restore topological order from dependency edges and pass the latest result/state directly."
          },
          "repair_exercise_ref": "b8.main-flow.repair.wrong-order-stale-state",
