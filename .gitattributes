# Paper 4 source, fixture, registry and generated files are byte-hashed.
# Keep existing Paper 4 files normalized to LF across checkouts.
* text=auto eol=lf

# Paper 2 and Paper 3 review records were generated from these exact file bytes.
# Preserve their release bytes across Windows and POSIX checkouts.
/app/api/paper2/** -text -eol
/app/components/paper2-*/** -text -eol
/app/lib/paper2/** -text -eol
/app/paper-2/** -text -eol
/content/paper2/** -text -eol
/scripts/*paper2*.mjs -text -eol
/scripts/lib/** -text -eol
/app/components/paper3-*/** -text -eol
/app/lib/paper3/** -text -eol
/app/paper-3/** -text -eol
/content/paper3/** -text -eol
/scripts/*paper3*.mjs -text -eol
/app/login/** -text -eol
/app/api/auth/** -text -eol
/app/lib/auth.ts -text -eol
/package.json -text -eol
/next.config.mjs -text -eol
/proxy.ts -text -eol
